+//
+// FixedMulAngle
+// b should be coming from finesine() or finecosine(), so its high word is either 0x0000 or 0xffff
+//
+#if defined __WATCOMC__
+//
+#else
+inline
+#endif
+fixed_t CONSTFUNC FixedMulAngle(fixed_t a, fixed_t b)
+{
+	uint16_t blw = b;
+	fixed_t r = FixedMul3216(a, blw);
+
+	if (b < 0)
+		r -= a;
+
+	return r;
+}

+jz reciprocal_result
+mov a,r7
+clr c
+subb a,#1
+mov r7,a
+mov a,r6
+subb a,#0
+mov r6,a
+reciprocal_result:
+mov dpl,r7
+mov dph,r6
+ret''')
+
+emit('''_DdrDrawColumn:
+mov draw_mode,dpl
+mov dptr,#_doom_draw_address''')

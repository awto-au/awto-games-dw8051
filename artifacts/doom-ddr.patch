+
+#if defined __WATCOMC__
+//
+#else
+inline
+#endif
+fixed_t CONSTFUNC FixedMul3216(fixed_t a, uint16_t blw)
+{
+	uint16_t alw = a;
+	 int16_t ahw = a >> FRACBITS;
+
+#if defined C_ONLY
+	uint32_t ll = (uint32_t) alw * blw;
+	 int32_t hl = ( int32_t) ahw * blw;
+	return (ll >> FRACBITS) + hl;
+#else
+	fixed_t result;
+	asm
+	(
+		"mov %%dx, %%si\n"
+		"mul %%cx\n"
+		"mov %%dx, %%bx\n"
+		"mov %%si, %%ax\n"
+		"cwd\n"
+		"and %%cx, %%dx\n"
+		"xor %%si, %%si\n"
+		"sub %%dx, %%si\n"
+		"mul %%cx\n"
+		"add %%bx, %%ax\n"
+		"adc %%si, %%dx"
+		: "=A" (result)
+		: "a" (alw), "d" (ahw), "c" (blw)
+		: "bx", "si"
+	);
+	return result;
+#endif
+}

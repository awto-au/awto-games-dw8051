+mov dpl,r4
+mov dph,r5
+mov b,r6
+mov a,r7
+ret
+add16:
+mov a,r4
+add a,#DOOM_DDR_BURST_BYTES
+mov r4,a
+mov a,r5
+addc a,#0
+mov r5,a
+mov a,r6
+addc a,#0
+mov r6,a
+mov a,r7
+addc a,#0
+mov r7,a
+ret
+
+_DdrFetch:
+mov r4,dpl
+mov r5,dph
+mov r6,b
+mov r7,a
+clr c
+subb a,#2
+jc fetch_in_range
+ljmp fetch_invalid
+fetch_in_range:
+mov a,r4
+swap a
+anl a,#0x0f
+mov r0,a
+mov a,r5
+anl a,#7
+swap a
+orl a,r0
+mov r0,a
+lcall match
+jnc fetch_miss
+mov dptr,#_ddr_hits
+lcall counter
+ljmp fetch_found
+fetch_miss:
+mov dptr,#_ddr_misses
+lcall counter
+lcall store_index
+jc fetch_evict_ok
+ljmp fetch_failed
+fetch_evict_ok:
+lcall bank_pointer
+inc dptr
+clr a
+movx @dptr,a
+lcall frame_touch
+jnc fetch_read_ddr
+lcall data_pointer
+mov r1,#DOOM_DDR_BURST_BYTES
+clr a
+fetch_zero:
+movx @dptr,a
+inc dptr
+djnz r1,fetch_zero

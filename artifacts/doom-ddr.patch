+djnz r1,read_wait
+djnz r2,read_wait
+djnz r3,read_retry
+mov dptr,#_ddr_fault
+mov a,#2
+movx @dptr,a
+sjmp fetch_failed
+read_complete:
+lcall data_pointer
+push 0x00
+lcall _DoomRead16
+pop 0x00
+mov a,#(DOOM_CACHE_VALID >> 8)
+fetch_commit:
+push acc
+lcall offset_pointer
+mov a,r4
+anl a,#0xf0
+movx @dptr,a
+inc dptr
+mov a,r5
+movx @dptr,a
+lcall bank_pointer
+mov a,r6
+movx @dptr,a
+inc dptr
+pop acc
+orl a,r7
+movx @dptr,a
+fetch_found:
+mov dpl,r0
+ret
+fetch_invalid:
+mov dptr,#_ddr_fault
+mov a,#3
+movx @dptr,a
+fetch_failed:
+mov dpl,#0xff
+ret
+
+_DdrStore:
+mov r0,dpl
+lcall store_index
+mov dpl,#0
+jnc store_return
+inc dpl
+store_return:
+ret
+
+; R0=index, R4..R7=new physical address. Preserve both across eviction.
+store_index:
+lcall bank_pointer
+movx a,@dptr
+mov r2,a
+inc dptr
+movx a,@dptr
+mov r3,a
+anl a,#((DOOM_CACHE_VALID | DOOM_CACHE_DIRTY) >> 8)
+cjne a,#((DOOM_CACHE_VALID | DOOM_CACHE_DIRTY) >> 8),store_clean
+push 0x04
+push 0x05
+push 0x06
+push 0x07
+mov a,r2
+mov r6,a
+mov a,r3
+anl a,#1
+mov r7,a
+lcall offset_pointer
+movx a,@dptr
+mov r4,a
+inc dptr
+movx a,@dptr
+mov r5,a
+lcall idle
+jnc store_pop
+lcall set_address
+lcall masks
+lcall data_pointer
+push 0x00
+lcall _DoomWrite16
+pop 0x00
+mov dptr,#DOOM_MCU_DC_CMD
+mov a,#DOOM_DDR_CMD_WRITE
+movx @dptr,a
+lcall idle
+jnc store_pop
+lcall bank_pointer
+inc dptr
+movx a,@dptr
+anl a,#0x7f
+movx @dptr,a
+setb c
+store_pop:
+pop 0x07
+pop 0x06
+pop 0x05
+pop 0x04
+ret
+store_clean:
+setb c
+ret
+
+_DdrMapRead:
+lcall _DdrFetch
+mov a,dpl
+cjne a,#0xff,map_read_valid
+mov dptr,#0
+ret
+map_read_valid:
+mov r0,a
+lcall data_pointer
+mov a,r4
+anl a,#0x0f
+orl a,dpl
+mov dpl,a
+ret
+
+_DdrMapWrite:
+lcall _DdrFetch
+mov a,dpl
+cjne a,#0xff,map_valid
+mov dptr,#0
+ret
+map_valid:
+mov r0,a
+lcall bank_pointer
+inc dptr
+movx a,@dptr
+orl a,#(DOOM_CACHE_DIRTY >> 8)
+movx @dptr,a
+lcall data_pointer
+mov a,r4
+anl a,#0x0f
+orl a,dpl
+mov dpl,a
+ret
+
+_DdrRead:
+lcall _DdrFetch
+mov a,dpl
+cjne a,#0xff,read_valid
+mov dpl,#0
+ret
+read_valid:
+mov r0,a
+lcall data_pointer
+mov a,r4
+anl a,#0x0f
+orl a,dpl
+mov dpl,a
+movx a,@dptr
+mov dpl,a
+ret
+
+; Public ABI 1: second byte in R7. Save it before address setup uses R7.
+_DdrWrite:
+push 0x07

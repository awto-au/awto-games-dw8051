+mov a,dpl
+orl a,dph
+jz write_failed
+pop acc
+movx @dptr,a
+ret
+write_failed:
+pop acc
+ret
+
+_DdrWriteRaw:
+mov r4,dpl
+mov r5,dph
+mov r6,b
+mov r7,a
+clr c
+subb a,#2
+jnc raw_invalid
+mov a,r4
+anl a,#0x0f
+jnz raw_invalid
+mov a,r4
+swap a
+anl a,#0x0f
+mov r0,a
+mov a,r5
+anl a,#7
+swap a
+orl a,r0
+mov r0,a
+lcall match
+jnc raw_keep_collision
+clr a
+movx @dptr,a
+raw_keep_collision:
+lcall idle
+jnc raw_return
+lcall set_address
+lcall masks
+mov dptr,#_doom_burst_source
+movx a,@dptr
+mov r1,a
+inc dptr
+movx a,@dptr
+mov dph,a
+mov dpl,r1
+lcall _DoomWrite16
+mov dptr,#DOOM_MCU_DC_CMD
+mov a,#DOOM_DDR_CMD_WRITE
+movx @dptr,a
+lcall idle
+jnc raw_return
+lcall frame_touch
+raw_return:
+ret
+raw_invalid:
+mov dptr,#_ddr_fault
+mov a,#3
+movx @dptr,a
+ret
+
+match:
+lcall offset_pointer
+movx a,@dptr
+mov r1,a
+mov a,r4
+anl a,#0xf0
+xrl a,r1
+jnz match_miss
+inc dptr
+movx a,@dptr
+xrl a,r5
+jnz match_miss
+lcall bank_pointer
+movx a,@dptr
+xrl a,r6
+jnz match_miss
+inc dptr
+movx a,@dptr
+anl a,#0x7f
+mov r1,a
+mov a,r7
+orl a,#(DOOM_CACHE_VALID >> 8)
+xrl a,r1
+jnz match_miss
+setb c
+ret
+match_miss:
+clr c
+ret
+
+offset_pointer:
+mov a,r0
+rl a
+mov dpl,a
+mov dph,#(DOOM_CACHE_OFFSETS_BASE >> 8)
+ret
+bank_pointer:
+mov a,r0
+rl a
+mov dpl,a
+mov dph,#(DOOM_CACHE_BANKS_BASE >> 8)

+mov fx_b+1,a
+clr a
+subb a,fx_b+2
+mov fx_b+2,a
+clr a
+subb a,fx_b+3
+mov fx_b+3,a
+fd_b_positive:
+; Exact Doom overflow guard, including INT_MIN and a zero divisor.
+mov a,fx_a+1
+rl a
+rl a
+anl a,#3
+mov fx_p+0,a
+mov a,fx_a+2
+rl a
+rl a
+anl a,#0xFC
+orl a,fx_p+0
+mov fx_p+0,a
+mov a,fx_a+2
+rl a
+rl a
+anl a,#3
+mov fx_p+1,a
+mov a,fx_a+3
+rl a
+rl a
+anl a,#0xFC
+orl a,fx_p+1
+mov fx_p+1,a
+mov a,fx_a+3
+rl a
+rl a
+anl a,#3
+mov fx_p+2,a
+clr c
+mov a,fx_p+0
+subb a,fx_b+0
+mov a,fx_p+1
+subb a,fx_b+1
+mov a,fx_p+2
+subb a,fx_b+2
+clr a
+subb a,fx_b+3
+jc fd_divide
+mov a,fx_sign
+jb acc.7,fd_min
+mov r4,#0x7F
+mov r5,#0xFF
+mov r6,#0xFF
+mov r7,#0xFF
+ret
+fd_min:
+mov r4,#0x80
+mov r5,#0
+mov r6,#0
+mov r7,#0
+ret
+fd_divide:
+; Skip known-zero quotient bytes: 16, 24 or 32 bit steps.
+clr c
+mov a,fx_a+0
+subb a,fx_b+0
+mov a,fx_a+1
+subb a,fx_b+1
+mov a,fx_a+2
+subb a,fx_b+2
+mov a,fx_a+3
+subb a,fx_b+3
+jc fd_start16
+clr c
+mov a,fx_a+1
+subb a,fx_b+0
+mov a,fx_a+2
+subb a,fx_b+1
+mov a,fx_a+3
+subb a,fx_b+2
+clr a
+subb a,fx_b+3
+jc fd_start24
+mov r0,fx_a+2
+mov r1,fx_a+3
+mov r2,#0
+mov r3,#0
+mov r4,#0
+mov r5,#0
+mov r6,fx_a
+mov r7,fx_a+1
+mov fx_p+3,#32
+sjmp fd_dispatch
+fd_start24:
+mov r0,fx_a+1
+mov r1,fx_a+2
+mov r2,fx_a+3
+mov r3,#0
+mov r4,#0
+mov r5,#0
+mov r6,#0
+mov r7,fx_a
+mov fx_p+3,#24
+sjmp fd_dispatch
+fd_start16:
+mov r0,fx_a+0
+mov r1,fx_a+1
+mov r2,fx_a+2
+mov r3,fx_a+3
+mov r4,#0
+mov r5,#0
+mov r6,#0
+mov r7,#0
+mov fx_p+3,#16
+fd_dispatch:
+mov a,fx_b+2
+orl a,fx_b+3
+jz fd_small
+ljmp fd32_loop
+fd_small:
+mov a,fx_b+1
+jz fd8_init
+ljmp fd16_init
+fd8_init:
+mov r1,fx_b
+mov r2,fx_p+3
+; A zero initial remainder permits one quotient byte in a five-cycle DIV AB.
+mov a,r0
+jnz fd8_loop
+mov a,r7
+mov b,r1
+div ab
+mov r0,b
+xch a,r4
+xch a,r5
+xch a,r6
+xch a,r7
+mov a,r2
+add a,#0xF8
+mov r2,a
+fd8_loop:
+mov a,r4
+add a,r4
+mov r4,a
+mov a,r5
+rlc a
+mov r5,a
+mov a,r6
+rlc a
+mov r6,a
+mov a,r7
+rlc a
+mov r7,a
+mov a,r0
+rlc a
+mov r0,a
+jc fd8_wrap
+subb a,r1
+jc fd8_next
+sjmp fd8_store
+fd8_wrap:
+clr c
+subb a,r1
+fd8_store:
+mov r0,a
+inc r4
+fd8_next:
+djnz r2,fd8_loop
+ljmp fd_finish
+fd16_init:
+mov r2,fx_b
+mov r3,fx_b+1
+fd16_loop:
+mov a,r4
+add a,r4
+mov r4,a
+mov a,r5
+rlc a
+mov r5,a
+mov a,r6
+rlc a
+mov r6,a
+mov a,r7
+rlc a
+mov r7,a
+mov a,r0
+rlc a
+mov r0,a
+mov a,r1
+rlc a
+mov r1,a
+jc fd16_wrap
+mov a,r0
+subb a,r2
+mov b,a
+mov a,r1
+subb a,r3
+jc fd16_next
+mov r1,a
+mov r0,b
+inc r4
+sjmp fd16_next
+fd16_wrap:
+clr c
+mov a,r0
+subb a,r2
+mov r0,a
+mov a,r1
+subb a,r3
+mov r1,a
+inc r4
+fd16_next:
+djnz fx_p+3,fd16_loop
+ljmp fd_finish
+fd32_loop:
+mov a,r4
+add a,r4
+mov r4,a
+mov a,r5
+rlc a
+mov r5,a
+mov a,r6
+rlc a
+mov r6,a
+mov a,r7
+rlc a
+mov r7,a
+mov a,r0
+rlc a
+mov r0,a
+mov a,r1
+rlc a
+mov r1,a
+mov a,r2
+rlc a
+mov r2,a
+mov a,r3
+rlc a
+mov r3,a
+; Signed magnitudes <= 0x80000000: shifted remainder cannot overflow 32 bits.
+mov a,r0
+subb a,fx_b+0
+mov a,r1
+subb a,fx_b+1
+mov a,r2
+subb a,fx_b+2
+mov a,r3
+subb a,fx_b+3
+jc fd32_next
+clr c
+mov a,r0
+subb a,fx_b+0
+mov r0,a
+mov a,r1
+subb a,fx_b+1
+mov r1,a
+mov a,r2
+subb a,fx_b+2
+mov r2,a
+mov a,r3
+subb a,fx_b+3
+mov r3,a
+inc r4
+fd32_next:
+djnz fx_p+3,fd32_loop
+fd_finish:
+mov a,fx_sign
+jnb acc.7,fd_positive
+clr c
+clr a
+subb a,r4
+mov r4,a
+clr a
+subb a,r5
+mov r5,a
+clr a
+subb a,r6
+mov r6,a
+clr a
+subb a,r7
+mov r7,a
+fd_positive:
+mov a,r4
+mov r0,a
+mov a,r5
+mov r1,a
+mov a,r7
+mov r4,a
+mov a,r6
+mov r5,a
+mov a,r1
+mov r6,a
+mov a,r0
+mov r7,a
+ret
diff --git a/fw/doom/fixed_stack_abi.asm b/fw/doom/fixed_stack_abi.asm
new file mode 100644
index 0000000..6dcab6f
--- /dev/null
+++ b/fw/doom/fixed_stack_abi.asm
@@ -0,0 +1,57 @@
+; SDCC little-endian --model-large --stack-auto --sdcccall 0.
+; a = DPL,DPH,B,A; b is four caller-pushed bytes below the return address.
+.module doom_fixed_stack_abi
+.globl _FixedMul, _FixedDiv, _DoomFixedMul, _DoomFixedDiv
+.globl _DdrWriteStack, _DdrWrite
+acc = 0xe0
+b = 0xf0
+.area CSEG (CODE)
+_DdrWriteStack:
+push acc
+mov a,sp
+add a,#0xfd
+mov r0,a
+mov a,@r0
+mov r7,a
+pop acc
+ljmp _DdrWrite
+_FixedMul:
+mov r7,dpl
+mov r6,dph
+mov r5,b
+mov r4,a
+lcall load_b
+lcall _DoomFixedMul
+sjmp result
+_FixedDiv:
+mov r7,dpl
+mov r6,dph
+mov r5,b
+mov r4,a
+lcall load_b
+lcall _DoomFixedDiv
+result:
+mov dpl,r7
+mov dph,r6
+mov b,r5
+mov a,r4
+ret
+load_b:
+; Our own LCALL added two more return-address bytes: entry SP - 7.
+mov a,sp
+add a,#0xf9
+mov r1,a
+mov a,@r1
+mov r3,a
+inc r1
+mov a,@r1
+mov r2,a
+inc r1
+mov a,@r1
+push acc
+inc r1
+mov a,@r1
+mov r0,a
+pop acc
+mov r1,a
+ret

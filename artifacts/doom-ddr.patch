+rl a
+mov r3,a
+mov a,r6
+rr a
+rr a
+rr a
+anl a,#0x1f
+orl a,r3
+movx @dptr,a
+inc dptr
+mov a,r6
+anl a,#7
+swap a
+rl a
+mov r3,a
+mov a,r5
+rr a
+rr a
+rr a
+anl a,#0x1f
+orl a,r3
+movx @dptr,a
+inc dptr
+mov a,r5
+anl a,#7
+swap a
+rl a
+mov r3,a
+mov a,r4
+anl a,#0xf0
+rr a
+rr a
+rr a
+orl a,r3
+movx @dptr,a
+mov dptr,#DOOM_MCU_DC_LEN

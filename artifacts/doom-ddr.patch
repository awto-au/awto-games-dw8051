+++ b/fw/doom/cache_config.h
@@ -0,0 +1,45 @@
+/* Fixed MCU SRAM pages shared by C misses and the DW8051 hot cache path.
+ * Dynamic XRAM is linked below E000h. DDR still uses MCU_DC transactions. */
+#ifndef DOOM_CACHE_CONFIG_H
+#define DOOM_CACHE_CONFIG_H
+#define DOOM_CACHE_LINES          128
+#define DOOM_CACHE_DATA_BASE      0xE000
+#define DOOM_CACHE_OFFSETS_BASE   0xE800
+#define DOOM_CACHE_BANKS_BASE     0xE900
+#define DOOM_CACHE_PALETTE_BASE   0xEA00
+#define DOOM_CACHE_BURST_BASE     0xED00
+#define DOOM_TEXTURE_COLUMN_BASE  0xED80
+#define DOOM_COLORMAP_BASE        0xEE00
+#define DOOM_TILE_BASE            0xEF00
+#define DOOM_FRAME_BITMAP_BASE    0xF000
+#define DOOM_FRAME_BITMAP_BYTES   256
+#define DOOM_TEXTURE_COLUMN_SIZE  128
+#define DOOM_TILE_SIZE            256
+#define DOOM_RGB_BLOCK_SIZE       48
+#define DOOM_CACHE_VALID          0x4000
+#define DOOM_CACHE_DIRTY          0x8000
+#define DOOM_CACHE_BANK_MASK      0x01FF
+#define DOOM_DDR_BURST_BYTES      16
+#define DOOM_DDR_CAPACITY         0x02000000
+#define DOOM_DDR_CMD_WRITE        0x80
+#define DOOM_DDR_CMD_READ         0xA0
+#define DOOM_DDR_READY            1
+#define DOOM_DDR_POLL_LIMIT       1024
+#define DOOM_DDR_READ_ATTEMPTS    3
+#define DOOM_PALETTE_BYTES        768
+#define DOOM_RASTER_BASE          0x01F00000
+#ifndef DOOM_RASTER_PITCH
+#define DOOM_RASTER_PITCH         192
+#endif
+#ifndef DOOM_VIEW_WIDTH
+#define DOOM_VIEW_WIDTH           60
+#endif
+#ifndef DOOM_VIEW_HEIGHT
+#define DOOM_VIEW_HEIGHT          128
+#endif
+#define DOOM_INDEXED_BASE         0x000F0010
+#define DOOM_SFR_CKCON            0x8E
+#define DOOM_SFR_MPAGE            0x92
+#define DOOM_MOVX_MASK            7
+#define DOOM_MOVX_DEFAULT         0
+#endif
diff --git a/fw/doom/cache_native.asm b/fw/doom/cache_native.asm
new file mode 100644
index 0000000..be85ce6
--- /dev/null
+++ b/fw/doom/cache_native.asm
@@ -0,0 +1,1048 @@
+; Generated by scripts/doom_cache_gen.py.
+; Native DW8051 bank-zero ABI; no interrupts or C calls.
+; Fifteen bytes of OSEG scratch, shared only with mutually exclusive routines.
+.module doom_cache_native
+.include "doom_cache_config.inc"
+.globl _DdrFetch, _DdrStore, _DdrRead, _DdrWrite, _DdrMapWrite, _DdrMapRead, _DdrWriteRaw
+.globl _DdrPresentRow, _DdrGatherTile, _DdrLoadColumn, _DdrLoadColorMap
+.globl _DdrClearFrame, _DdrPresentFrame, _DdrDrawColumn
+.globl _doom_draw_address, _doom_draw_count, _doom_draw_color, _doom_frame_active
+.globl _doom_column_frac, _doom_column_step
+.globl _DoomShadeRun, _DoomFillChunk
+.globl _DoomReciprocalStep, _DoomFixedDiv
+.globl _ddr_fault, _ddr_hits, _ddr_misses, _doom_burst_source
+.globl _doom_colormap_address, _doom_texture_address
+.globl _DoomWrite16, _DoomRead16, _DoomCopy16, _DoomTranspose16, _DoomExpand16
+acc = 0xe0
+b = 0xf0
+.area OSEG (OVR,DATA)
+copy_target: .ds 2
+copy_blocks: .ds 1
+.ds 12
+; These 15 bytes overlay the mutually exclusive clear/column-copy scratch.
+; Gather, expand and burst-write callees do not use OSEG.
+present_source = copy_target
+present_tile = copy_target + 4
+present_row = copy_target + 8
+present_x = copy_target + 12
+present_y = copy_target + 13
+present_n = copy_target + 14
+draw_source = copy_target
+draw_remaining = copy_target + 4
+draw_color = copy_target + 5
+draw_mode = copy_target + 6
+draw_chunk = copy_target + 7
+draw_target = copy_target + 8
+.area CSEG (CODE)
+_DoomReciprocalStep:
+; Exact low 16 bits of (0xffffffff / d) >> 7, for positive d.
+; floor(floor(N/d)/128) = floor((2^25-1)/d).
+; FixedDiv(512,d) gives floor(2^25/d); subtract one iff d divides 2^25.
+mov r0,a
+mov r1,b
+mov r2,dph
+mov r3,dpl
+clr c
+subb a,#2
+jc reciprocal_small
+mov dptr,#0
+ret
+reciprocal_small:
+mov a,r0
+orl a,r1
+orl a,r2
+orl a,r3
+jnz reciprocal_nonzero
+mov dptr,#0
+ret
+reciprocal_nonzero:
+clr c
+mov a,r3
+subb a,#1
+anl a,r3
+mov r7,a
+mov a,r2
+subb a,#0
+anl a,r2
+orl a,r7
+mov r7,a
+mov a,r1
+subb a,#0
+anl a,r1
+orl a,r7
+mov r7,a
+mov a,r0
+subb a,#0
+anl a,r0
+orl a,r7
+jnz reciprocal_no_correction
+mov a,#1
+sjmp reciprocal_divide
+reciprocal_no_correction:
+clr a
+reciprocal_divide:
+push acc
+mov r4,#0
+mov r5,#0
+mov r6,#2
+mov r7,#0
+lcall _DoomFixedDiv
+pop acc
+jz reciprocal_result
+mov a,r7
+clr c
+subb a,#1
+mov r7,a
+mov a,r6
+subb a,#0
+mov r6,a
+reciprocal_result:
+mov dpl,r7
+mov dph,r6
+ret
+_DdrDrawColumn:
+mov draw_mode,dpl
+mov dptr,#_doom_draw_address
+movx a,@dptr
+mov (draw_source+0),a
+inc dptr
+movx a,@dptr
+mov (draw_source+1),a
+inc dptr
+movx a,@dptr
+mov (draw_source+2),a
+inc dptr
+movx a,@dptr
+mov (draw_source+3),a
+inc dptr
+mov dptr,#_doom_draw_count
+movx a,@dptr
+jnz draw_nonempty
+ret
+draw_nonempty:
+mov draw_remaining,a
+mov dptr,#_doom_draw_color
+movx a,@dptr
+mov draw_color,a
+draw_next:
+mov a,draw_source
+anl a,#15
+cpl a
+add a,#17
+mov draw_chunk,a
+clr c
+subb a,draw_remaining
+jc draw_chunk_ready
+mov draw_chunk,draw_remaining
+draw_chunk_ready:
+mov r4,(draw_source+0)
+mov r5,(draw_source+1)
+mov r6,(draw_source+2)
+mov r7,(draw_source+3)
+lcall prepare_address
+lcall _DdrMapWrite
+mov a,dpl
+orl a,dph
+jnz draw_valid
+ret
+draw_valid:
+mov a,draw_mode
+jnz draw_shaded
+mov b,draw_color
+mov a,draw_chunk
+lcall _DoomFillChunk
+sjmp draw_advance
+draw_shaded:
+mov draw_target,dpl
+mov (draw_target+1),dph
+mov dptr,#_doom_column_step
+movx a,@dptr
+mov r4,a
+inc dptr
+movx a,@dptr
+mov r5,a
+mov dptr,#_doom_column_frac
+movx a,@dptr
+mov r6,a
+inc dptr
+movx a,@dptr
+mov r7,a
+mov r2,draw_chunk
+mov dpl,draw_target
+mov dph,(draw_target+1)
+lcall _DoomShadeRun
+mov r0,dpl
+mov r1,dph
+mov dptr,#_doom_column_frac
+mov a,r0

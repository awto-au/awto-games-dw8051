+data_pointer:
+mov a,r0
+swap a
+anl a,#0xf0
+mov dpl,a
+mov a,r0
+swap a
+anl a,#0x0f
+add a,#(DOOM_CACHE_DATA_BASE >> 8)
+mov dph,a
+ret
+
+masks:
+mov dptr,#DOOM_MCU_DC_MASK_H
+clr a
+movx @dptr,a
+inc dptr
+movx @dptr,a
+ret
+
+idle:
+mov dptr,#DOOM_MCU_DC_CMD
+mov r1,#0
+mov r2,#(DOOM_DDR_POLL_LIMIT / 256)

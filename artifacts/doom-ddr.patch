+//
+// R_RenderView
+//
+void R_RenderPlayerView (player_t* player)
+{
+    R_SetupFrame (player);
+
+    // Clear buffers.
+    R_ClearClipSegs ();
+    R_ClearDrawSegs ();
+    R_ClearOpeningClippingDetermination ();
+
+#if !defined FLAT_SPAN
+    R_ClearPlanes ();
+#endif
+
+    R_ClearOpenings ();
+    R_ClearSprites ();
+
+    // The head node is the last node output.
+    R_RenderBSPNode (numnodes-1);
+
+#if defined FLAT_SPAN
+    R_FreeSkyPatch ();
+#else
+    R_DrawPlanes ();
+#endif
+
+    R_DrawMasked ();
+}

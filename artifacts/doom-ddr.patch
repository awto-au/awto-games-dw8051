index 0000000..2a69a3b
--- /dev/null
+++ b/scripts/doom_play.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+"""Keyboard-controlled native Doom walkthrough prototype + MJPEG/VLC stream.
+
+Input is the only host-to-CPU change after boot. Physics, doors and pixels run
+on the DW8051 core. The host preview's 25 Hz cap is not hardware performance.
+"""
+import argparse
+import io
+import json
+import struct
+import threading
+import time
+from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
+from pathlib import Path
+import doom_renderer as R
+import doom_motion as M
+
+PAGE='''<!doctype html><meta charset="utf-8"><title>Native scaler walkthrough</title>
+<style>body{background:#17191c;color:#e8e8e8;font:16px system-ui;margin:24px auto;max-width:980px}img{width:100%;image-rendering:pixelated;background:black;aspect-ratio:15/8}button{font:inherit;padding:8px 20px}#status{font-variant-numeric:tabular-nums}</style>
+<h1>Native scaler walkthrough</h1><p>W/S: forward/back · A/D: strafe · arrows: turn · Space/E: use door · F/Ctrl: fire · Shift: faster</p>
+<p>Native combat prototype. Pistol, health, ammo and ground monsters work. Imps throw fireballs; soldiers fire from range. Walk over items and keys to collect them. Coloured locks need a matching key. Space/E also operates tagged door and exit switches. Exits finish this session; next-map loading is not implemented. Sound is not implemented. At zero health, stop and restart the simulator.</p>
+<img src="/stream" alt="Native framebuffer"><p id="status">Starting simulator…</p><button id="stop">Stop</button>
+<script>const held=new Set();let stopped=false;
+const controls=new Set(['KeyW','KeyS','KeyA','KeyD','ArrowLeft','ArrowRight','Space','KeyE','ShiftLeft','ShiftRight','KeyF','ControlLeft','ControlRight']);
+function command(){let speed=held.has('ShiftLeft')||held.has('ShiftRight')?8:4;return {enabled:1,forward:speed*((held.has('KeyW')?1:0)-(held.has('KeyS')?1:0)),strafe:speed*((held.has('KeyA')?1:0)-(held.has('KeyD')?1:0)),turn:768*((held.has('ArrowLeft')?1:0)-(held.has('ArrowRight')?1:0)),buttons:((held.has('Space')||held.has('KeyE'))?1:0)|((held.has('KeyF')||held.has('ControlLeft')||held.has('ControlRight'))?2:0)};}
+async function send(){if(!stopped)try{await fetch('/input',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(command())});}catch(e){}}
+onkeydown=e=>{if(controls.has(e.code)){e.preventDefault();held.add(e.code);send();}};
+onkeyup=e=>{if(controls.has(e.code)){e.preventDefault();held.delete(e.code);send();}};
+onblur=()=>{held.clear();send();};document.onvisibilitychange=()=>{if(document.hidden){held.clear();send();}};
+setInterval(send,100);setInterval(async()=>{if(stopped)return;try{let s=await(await fetch('/state')).json();if(s.frame!==undefined)document.getElementById('status').textContent=`Frame ${s.frame} · CPU-model frame ${s.model_ms.toFixed(1)} ms · use activations ${s.doors.activations}${s.combat ? ` · Health ${s.combat.health} · Ammo ${s.combat.ammo} · Kills ${s.combat.kills}${s.combat.dead ? ' · DEAD' : ''}` : ''}${s.pickups ? ` · Pickups ${s.pickups.stats.collected}` : ''}${s.switches ? ` · Switches ${s.switches.stats.activations}` : ''}${s.exit && s.exit.kind ? ` · LEVEL COMPLETE${s.exit.kind===2 ? ' (secret exit)' : ''}` : ''}${s.inventory ? ` · Keys ${[[9,'blue'],[18,'yellow'],[36,'red']].filter(([mask])=>s.inventory.keys&mask).map(([,name])=>name).join(', ')||'none'}${s.inventory.notice ? ` · Need ${['','blue','yellow','','red'][s.inventory.needed]} key` : ''}` : ''}`;}catch(e){}},250);
+document.getElementById('stop').onclick=async()=>{held.clear();await send();stopped=true;try{await fetch('/stop',{method:'POST'});}catch(e){}document.getElementById('status').textContent='Stopped';};</script>'''
+
+class PlaySession:
+    def __init__(self,preview_hz=25):
+        self.condition=threading.Condition();self.latest=dict(enabled=1)
+        self.updated=time.monotonic();self.stop=threading.Event();self.jpeg=b'';self.state={};self.sequence=0;self.pending_buttons=0
+        self.interval=1/preview_hz if preview_hz else 0;self.next_frame=time.monotonic()
+    def command(self,index):
+        with self.condition:
+            command=self.latest.copy() if time.monotonic()-self.updated<0.5 else dict(enabled=1)
+            if self.pending_buttons:command['buttons']=command.get('buttons',0)|self.pending_buttons;self.pending_buttons=0
+            return command
+    def set_command(self,value):
+        if not isinstance(value,dict):raise ValueError('expected command object')
+        try:M.pack_command(value)
+        except (TypeError,ValueError,OverflowError,struct.error) as error:raise ValueError('invalid command') from error
+        with self.condition:
+            self.pending_buttons|=value.get('buttons',0)&~self.latest.get('buttons',0)&3
+            self.latest=value.copy();self.updated=time.monotonic()
+    def frame(self,image,record,index):
+        from PIL import Image
+        preview=image.resize((480,256),Image.Resampling.NEAREST)
+        buf=io.BytesIO();preview.save(buf,'JPEG',quality=90)
+        with self.condition:
+            self.jpeg=buf.getvalue();self.state=dict(record,frame=index);self.sequence+=1;self.condition.notify_all()
+        self.next_frame=max(self.next_frame+self.interval,time.monotonic())
+        self.stop.wait(max(0,self.next_frame-time.monotonic()))
+        return not self.stop.is_set()
+
+def make_server(session,port=8099):
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self,*args):pass
+        def reply(self,status,body,content_type='application/json'):
+            if not isinstance(body,bytes):body=json.dumps(body).encode()
+            self.send_response(status);self.send_header('Content-Type',content_type);self.send_header('Content-Length',str(len(body)));self.send_header('Cache-Control','no-store');self.end_headers();self.wfile.write(body)
+        def do_GET(self):
+            if self.path=='/':return self.reply(200,PAGE.encode(),'text/html; charset=utf-8')
+            if self.path=='/state':
+                with session.condition:state=session.state.copy()
+                return self.reply(200,state)
+            if self.path=='/frame.jpg':
+                with session.condition:jpg=session.jpeg
+                return self.reply(200,jpg,'image/jpeg')
+            if self.path!='/stream':return self.reply(404,{'error':'not found'})
+            self.send_response(200);self.send_header('Content-Type','multipart/x-mixed-replace; boundary=frame');self.end_headers();last=-1
+            try:
+                while not session.stop.is_set():
+                    with session.condition:
+                        session.condition.wait_for(lambda:session.sequence!=last or session.stop.is_set(),timeout=1)
+                        jpg,last=session.jpeg,session.sequence
+                    if jpg:self.wfile.write(b'--frame\r\nContent-Type: image/jpeg\r\nContent-Length: '+str(len(jpg)).encode()+b'\r\n\r\n'+jpg+b'\r\n');self.wfile.flush()
+            except (BrokenPipeError,ConnectionResetError):pass
+        def do_POST(self):
+            if self.path=='/stop':session.stop.set();return self.reply(200,{'stopped':True})
+            if self.path!='/input':return self.reply(404,{'error':'not found'})
+            try:
+                length=int(self.headers.get('Content-Length','0'))
+                if not 0<length<=2048:raise ValueError('invalid length')
+                session.set_command(json.loads(self.rfile.read(length)))
+            except (ValueError,TypeError,OverflowError,UnicodeError):return self.reply(400,{'error':'invalid input'})
+            return self.reply(200,{'accepted':True})
+    server=ThreadingHTTPServer(('127.0.0.1',port),Handler);server.daemon_threads=True
+    return server
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--out',type=Path,required=True,help='existing doom_renderer build directory')
+    p.add_argument('--wad',type=Path);p.add_argument('--packed',type=Path);p.add_argument('--map',default='E1M1');p.add_argument('--pose',type=Path);p.add_argument('--port',type=int,default=8099)
+    p.add_argument('--frames',type=int,default=65535);p.add_argument('--latency',type=int,default=64)
+    p.add_argument('--scene',type=Path,help='initial demonstration edits')
+    a=p.parse_args()
+    if not a.wad and not a.packed:p.error('provide --wad or --packed')
+    session=PlaySession();server=make_server(session,a.port)
+    threading.Thread(target=server.serve_forever,daemon=True).start()
+    print(f'Keyboard preview http://127.0.0.1:{server.server_port}/',flush=True)
+    print(f'VLC stream http://127.0.0.1:{server.server_port}/stream',flush=True)
+    try:
+        R.simulate(a.wad,a.out,mapname=a.map,packed=a.packed,frames=a.frames,initial_pose=json.loads(a.pose.read_text()) if a.pose else None,
+                   input_provider=session.command,on_frame=session.frame,save_frames=False,latency=a.latency,scene=json.loads(a.scene.read_text()) if a.scene else None)
+    except KeyboardInterrupt:pass
+    finally:
+        session.stop.set()
+        with session.condition:session.condition.notify_all()
+        server.shutdown();server.server_close()
+
+if __name__=='__main__':main()
diff --git a/scripts/doom_renderer.py b/scripts/doom_renderer.py
new file mode 100644
index 0000000..9afe495
--- /dev/null
+++ b/scripts/doom_renderer.py
@@ -0,0 +1,609 @@
+#!/usr/bin/env python3
+"""Build/run the first native Doom8088 wall/BSP renderer on the DDC fast core.
+
+No host rendering: Python packs WAD assets and loads simulated DDR, then the
+8051 executes projection, BSP traversal, clipping, columns and palette output.
+This is renderer/controller bring-up with native combat, fireballs and pickups, not a complete Doom port.
+"""
+from __future__ import annotations
+import argparse
+import json
+import re
+import struct
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "fw/doom/vendor/Doom8088"
+FLAGS = ["-mmcs51", "--model-large", "--stack-auto", "--opt-code-speed",
+         "--std-sdcc11", "--disable-warning", "283", "-DC_ONLY", "-DFLAT_SPAN",
+         "-DFLAT_SKY", "-DPROFILING"]
+
+
+def run(args, **kw):
+    kw.setdefault("timeout",120)
+    p = subprocess.run([str(a) for a in args], stdin=subprocess.DEVNULL, capture_output=True, text=True, **kw)
+    if p.returncode:
+        raise RuntimeError(" ".join(map(str, args)) + "\n" + p.stdout + p.stderr)
+    return p.stdout
+
+
+def function_replace(text, name, replacement):
+    # Applied to preprocessed C, with no braces in strings in these functions.
+    m = re.search(r"^[^;{}\n]*\b" + name + r"\s*\([^;{}]*?\)\s*\{", text, re.M)
+    if not m:
+        raise ValueError("function not found: " + name)
+    pos, depth = m.end(), 1
+    while depth:
+        if text[pos] == "{": depth += 1
+        elif text[pos] == "}": depth -= 1
+        pos += 1
+    return text[:m.start()] + replacement + text[pos:]
+
+
+def assemble_c(sdcc, flags, src, output):
+    """Keep new compiler output compatible with installed SDAS 4.5.
+
+    SDAS 4.5 correctly relocates a bit alias (b0 = bits[0]), but interprets
+    inline relocatable bits[0] in an instruction as the byte address. That
+    writes another IRAM byte, potentially a return address. Emit the canonical
+    alias form used by stock SDCC 4.5; never paper over this at runtime.
+    """
+    asm = output.with_suffix(".asm")
+    run([sdcc,*flags,"-S",src,"-o",asm])
+    text = asm.read_text()
+    if "bits[" in text and not re.search(r"^\s*b0\s*=",text,re.M):
+        text = re.sub(r"bits\[([0-7])\]",r"doom_b\1",text)
+        aliases = "\n".join(f"doom_b{i} = bits[{i}]" for i in range(8))
+        text = re.sub(r"(\nbits:\n\s*\.ds 1\n)",r"\1"+aliases+"\n",text)
+    text = text.replace(" sdcccall(0)","")
+    if src.name == "ddr_cache.c":
+        # Cache misses never call Doom fixed maths, and fixed maths never
+        # accesses DDR. With interrupts disabled their DATA scratch can share
+        # one bounded overlay; pointer-bridge return scratch remains separate.
+        text = text.replace(".area DSEG    (DATA)",".area OSEG (OVR,DATA)")
+    asm.write_text(text)
+    run([sdcc.parent/"sdas8051","-losg",output,asm])
+
+
+def cache_config(out, overrides=None):
+    import ddr_sim
+    if overrides is None and (out/"cache-config.json").exists():
+        return json.loads((out/"cache-config.json").read_text())
+    header = (ROOT/"fw/doom/cache_config.h").read_text()
+    values = {name:int(value,0) for name,value in re.findall(r"^#define\s+(DOOM_\w+)\s+(0x[0-9A-Fa-f]+|\d+)\s*$",header,re.M)}
+    regs = ddr_sim.registers()
+    for name,reg in {"WRITE_BASE":"DATABUF_W_00", "READ_BASE":"DATABUF_R_00", "CMD":"CMD", "LEN":"LEN",
+                     "ADDR_H":"ADDR_H", "READ_FLAG":"READ_FLAG", "MASK_H":"WMASK_H"}.items():
+        values["DOOM_MCU_DC_"+name] = regs["MCU_DC_"+reg+"_A"]
+    sdk = (ROOT/"fw/sdk/Project/Header/AwtoRegs.h").read_text()
+    values["DOOM_MCU_DC_CMD_MASK"] = int(re.search(r"#define\s+AWTO_F_MCU_DC_CMD_A_DDR_A_CMD\s+(0x[0-9A-Fa-f]+)",sdk).group(1),0)
+    values.update(overrides or {})
+    # Presentation writes complete 16-pixel tiles, including right-edge padding.
+    values["DOOM_RASTER_PITCH"] = ((values["DOOM_VIEW_WIDTH"]+15)//16)*48
+    # SDAS stores expression values in 24 bits; a 32-bit DDR base must not be
+    # right-shifted there. Emit its four bytes from Python's full-width value.
+    for name in ("DOOM_INDEXED_BASE", "DOOM_RASTER_BASE"):
+        for byte in range(4): values[f"{name}_BYTE{byte}"] = (values[name] >> (byte*8)) & 255
+    values["DOOM_FRAME_INDEXED_BYTES"] = ((values["DOOM_VIEW_WIDTH"]+15)//16)*16*values["DOOM_TEXTURE_COLUMN_SIZE"]
+    assert values["DOOM_CACHE_LINES"] == 128
+    (out/"doom_cache_config.inc").write_text("\n".join(f"{name} = 0x{value:X}" for name,value in values.items())+"\n")
+    (out/"cache-config.json").write_text(json.dumps(values,indent=2)+"\n")
+    return values
+
+
+def assemble_runtime(sdcc, out, name):
+    source = ROOT/"fw/doom"/(name+".asm")
+    if name == "fixed_math":
+        target = out/"fixed_math.asm"
+        target.write_text(source.read_text().replace(".area DSEG (DATA)",".area OSEG (OVR,DATA)"))
+        source = target
+    run([sdcc.parent/"sdas8051","-losg","-I"+str(out),out/(name+".rel"),source])
+
+
+def prepare(sdcc, out, flags, width, height):
+    import shutil
+    for p in SOURCE.glob("*.h"): shutil.copyfile(p, out / p.name)
+    (out / "compiler.h").write_text("""#ifndef __COMPILER__
+#define __COMPILER__
+#define __far
+#define LITTLE_ENDIAN 1234
+#define BIG_ENDIAN 4321
+#define BYTE_ORDER LITTLE_ENDIAN
+typedef uint16_t segment_t;
+#define SIZE_OF_SEGMENT_T 2
+#define D_MK_FP(s,o) ((void*)(s))
+#define D_FP_SEG(p) ((segment_t)(p))
+#define D_FP_OFF(p) 0
+#define _fmemcmp memcmp
+#define _fmemcpy memcpy
+#define _fmemset memset
+#define _fstrcpy strcpy
+#define _fstrlen strlen
+#endif
+""")
+    p = out / "config.h"
+    p.write_text(p.read_text().replace("__attribute__((packed))", "").replace("#define inline __inline__", "#define inline inline"))
+    p = out / "r_main.h"
+    p.write_text(p.read_text().replace("fullcolormap[256 * 34]", "*fullcolormap"))
+    p = out/"doomdef.h"
+    p.write_text(re.sub(r"(#define\s+VIEWWINDOWHEIGHT\s+)128\b",rf"\g<1>{height}",p.read_text()))
+    for f in ("r_draw.c", "tables.c"): shutil.copyfile(SOURCE / f, out / f)
+    text = run([sdcc, *flags, "-E", out / "r_draw.c"])
+    text = re.sub(r"^#line.*\n", "", text, flags=re.M)
+    text = re.sub(r"^inline\s*\n", "", text, flags=re.M)
+    # Remove the thing/sprite pass for this explicitly renderer-only milestone.
+    start = text.index("typedef struct vissprite_s")
+    end = text.index("static fixed_t R_ScaleFromGlobalAngle", start)
+    text = text[:start] + text[end:]
+    start = text.index("static void R_ProjectSprite")
+    end = text.index("static void R_RenderSegLoop", start)
+    text = text[:start] + """
+void R_PlatformTexture(int16_t n, int16_t col, draw_column_vars_t *dc);
+static void R_DrawSegTextureColumn(const texture_t *tex, int16_t n, int16_t col, draw_column_vars_t *dc)
+{ tex; R_PlatformTexture(n, col, dc); }
+""" + text[end:]
+    for name in ("R_DrawMaskedColumn", "R_InitColormaps"):
+        text = function_replace(text, name, "")
+    text = re.sub(r"^.*R_AddSprites\(sub, frontsector->lightlevel\);.*$", "", text, flags=re.M)
+    text = text.replace("R_ClearSprites ();", "").replace("R_DrawMasked ();", "")
+    text = function_replace(text, "FixedMul", "")
+    text = function_replace(text, "FixedMul3232", "")
+    text = function_replace(text, "FixedMulAngle", "fixed_t FixedMulAngle(fixed_t a, fixed_t b) { return FixedMul(a,b); }")
+    text = function_replace(text, "FixedMul3216", "fixed_t FixedMul3216(fixed_t a, uint16_t b) { return FixedMul(a,(fixed_t)b); }")
+    text = function_replace(text, "FixedApproxDiv", "fixed_t FixedDiv(fixed_t a, fixed_t b);\nfixed_t FixedApproxDiv(fixed_t a, fixed_t b) { return FixedDiv(a,b); }")
+    text = text.replace("(0xffffffffu/((uint32_t)rw_scale)) >> (8 - 1)",
+                        "DoomReciprocalStep((uint32_t)rw_scale)")
+    # awto-sdcc currently drops the generic tag in this pointer/null ternary.
+    # Preserve a real generic pointer assignment in an explicit branch.

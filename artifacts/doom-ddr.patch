+//
+// R_SortVisSprites
+//
+
+// insertion sort
+static void isort(vissprite_t **s, int16_t n)
+{
+	for (int16_t i = 1; i < n; i++)
+	{
+		vissprite_t *temp = s[i];
+		if (s[i - 1]->scale < temp->scale)
+		{
+			int16_t j = i;
+			while ((s[j] = s[j - 1])->scale < temp->scale && --j)
+				;
+			s[j] = temp;
+		}
+	}
+}

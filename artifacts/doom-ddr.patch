+  fixed_t gz;                   // global bottom for silhouette clipping
+  fixed_t startfrac;           // horizontal position of x1
+  fixed_t scale;
+  fixed_t xiscale;             // negative if flipped
+  fixed_t texturemid;
+  uint16_t fracstep;
+
+  int16_t lump_num;

diff --git a/fw/doom/vendor/Doom8088/d_player.h b/fw/doom/vendor/Doom8088/d_player.h
new file mode 100644
index 0000000..56f7852
--- /dev/null
+++ b/fw/doom/vendor/Doom8088/d_player.h
@@ -0,0 +1,216 @@
+/* Emacs style mode select   -*- C++ -*-
+ *-----------------------------------------------------------------------------
+ *
+ *
+ *  PrBoom: a Doom port merged with LxDoom and LSDLDoom
+ *  based on BOOM, a modified and improved DOOM engine

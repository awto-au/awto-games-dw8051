+        assert f[-1]['actors']['things'][i]['frame']==11
+    assert f[-1]['motion']['x']>2240*65536  # player crossed the dead body's box
+    assert len({(x['actors']['things'][0]['x'],x['actors']['things'][0]['y']) for x in f})==1

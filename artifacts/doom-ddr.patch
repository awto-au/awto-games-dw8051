+    text += "\n" + (ROOT/"fw/doom/sprites.inc").read_text()+"\n"+(ROOT/"fw/doom/actors.inc").read_text()+"\n"+(ROOT/"fw/doom/combat.inc").read_text()
+    text += "\nvoid R_PlatformInit(void) {\n" + "\n".join(initializers) + """

+;  some of which are compiled with SDCC, to produce an executable,
+;  this library does not by itself cause the resulting executable to
+;  be covered by the GNU General Public License. This exception does
+;  not however invalidate any other reasons why the executable file
+;  might be covered by the GNU General Public License.
+;--------------------------------------------------------------------------
+
+	.area HOME    (CODE)
+	.area GSINIT0 (CODE)
+	.area GSINIT1 (CODE)
+	.area GSINIT2 (CODE)
+	.area GSINIT3 (CODE)
+	.area GSINIT4 (CODE)
+	.area GSINIT5 (CODE)
+	.area GSINIT  (CODE)
+	.area GSFINAL (CODE)
+	.area CSEG    (CODE)
+
+	.area HOME    (CODE)
+
+; compares two generic pointers.
+; if p1 < p2  return NZ and C
+; if p1 == p2 return  Z and NC
+; if p1 > p2  return NZ and NC
+; if both are a NULL pointer (yes, we have several) also return Z and NC
+; assumes that banks never map to address 0x0000
+; so it suffices to check dptr part only and ignore b
+
+sdcc_gptr_cmp::
+	mov  a,sp
+	add  a,#0xfc
+	clr  c
+	xch  a,r0
+	push acc
+	mov  a,@r0
+	inc  r0
+	orl  a,@r0
+	inc  r0
+	orl  a,@r0
+	dec  r0
+	jnz  00001$
+	mov  a,dpl
+	orl  a,dph
+	orl  a,b
+; if both are NULL, return Z and NC
+	jz   00002$
+00001$:
+	push dpl
+	dec  r0
+	mov  a,dpl
+	subb a,@r0
+	mov  dpl,a
+	inc  r0
+	mov  a,dph
+	subb a,@r0
+	orl  dpl,a
+	inc  r0
+	mov  a,b
+	subb a,@r0
+	orl  a,dpl
+; p2 < p1, return NZ and C
+; p2 = p1, return Z and NC
+; p2 > p1, return NZ and NC
+	pop  dpl
+00002$:
+	xch  a,r0
+	pop  acc
+	xch  a,r0
+	ret
+
+.globl bp
+.area DSEG (DATA)
+bp: .ds 1
diff --git a/fw/doom/motion.c b/fw/doom/motion.c
new file mode 100644
index 0000000..47140b1
--- /dev/null
+++ b/fw/doom/motion.c
@@ -0,0 +1,279 @@
+/* Standalone player/ground-actor collision for the renderer milestone.
+ * Bounded 35 Hz commands, outward-rounded player box, live portal heights,
+ * axis sliding and floor snapping. No original thinkers, momentum or gravity.
+ * All collision decisions execute here as native SDCC MCS51 instructions. */
+#include "motion.h"
+#include "doors.h"
+#include <string.h>
+
+volatile __xdata __at(MOTION_INPUT_BASE) motion_input_t motion_input;
+volatile __xdata __at(MOTION_STATE_BASE) motion_state_t motion_state;
+static uint32_t line_base;
+static const uint16_t *blockmap;
+static int16_t origin_x,origin_y;
+static uint16_t map_width,map_height,line_count;
+static uint8_t fraction;
+static int16_t touch_floor,touch_ceiling,centre_floor,centre_ceiling;
+static uint8_t query_sector,world_changed,actor_query;
+static int16_t query_floor;
+static uint8_t (*things_block)(int16_t,int16_t);
+void MotionSetThingsBlock(uint8_t (*check)(int16_t,int16_t)) {things_block=check;}
+int16_t motion_actor_floor;
+static int16_t grid_lx,grid_hx,grid_hy,grid_x,grid_y;
+static const uint16_t *grid_list;
+static uint16_t grid_remaining;
+static __xdata uint8_t visited[(MOTION_LINE_LIMIT+7)/8];
+static __xdata motion_line_t current;
+int32_t finesineapprox(int16_t angle);
+int32_t finecosineapprox(int16_t angle);
+
+void MotionInit(uint32_t lines,uint32_t blocks,uint16_t count)
+{
+    line_base=lines;
+    blockmap=DdrPointer(blocks);
+    line_count=count;
+    origin_x=(int16_t)blockmap[0]; origin_y=(int16_t)blockmap[1];
+    map_width=blockmap[2]; map_height=blockmap[3];
+    fraction=0;world_changed=0;actor_query=0;things_block=0;
+    centre_floor=motion_state.floor;centre_ceiling=motion_state.ceiling;
+    motion_state.ticks=0;
+    motion_state.blocked=motion_state.frame_ticks=motion_state.fault=motion_state.enabled=0;
+    if((int32_t)centre_ceiling-centre_floor<MOTION_PLAYER_HEIGHT)motion_state.fault=4;
+    if (!map_width || !map_height || !count || count>MOTION_LINE_LIMIT) motion_state.fault=1;
+}
+
+void MotionWorldChanged(void) {world_changed=1;}
+
+void MotionRefreshLine(uint16_t line)
+{
+    static uint16_t source;
+    static uint8_t front,back;
+    static int16_t a,b;
+    source=(uint16_t)DdrMapRead(line_base+((uint16_t)line<<4));
+    if(!source){motion_state.fault=3;return;}
+    front=((const __xdata uint8_t *)source)[13];back=((const __xdata uint8_t *)source)[14];
+    a=DoorSectorCeiling(front);b=DoorSectorCeiling(back);
+    /* Sector reads can evict the profile: reacquire before writing its top. */
+    source=(uint16_t)DdrMapWrite(line_base+((uint16_t)line<<4)+10);
+    if(!source){motion_state.fault=3;return;}
+    *(__xdata int16_t *)source=a<b ? a:b;
+}
+
+static void scan_start(int16_t lx,int16_t hx,int16_t ly,int16_t hy)
+{
+    memset(visited,0,(line_count+7)>>3);
+    grid_lx=lx;grid_hx=hx;grid_hy=hy;grid_x=lx-1;grid_y=ly;grid_list=0;
+}
+static uint16_t scan_next(void)
+{
+    static uint16_t id;
+    static uint8_t mask;
+    for(;;){
+        if(!grid_list){
+            if(++grid_x>grid_hx){grid_x=grid_lx;++grid_y;}
+            if(grid_y>grid_hy)return 0xFFFF;
+            grid_list=blockmap+blockmap[4+(uint16_t)grid_y*map_width+grid_x]+1;
+            grid_remaining=line_count+1;
+        }
+        if(!grid_remaining--){motion_state.fault=2;return 0xFFFF;}
+        id=*grid_list++;
+        if(id==0xFFFF){grid_list=0;continue;}
+        if(id>=line_count){motion_state.fault=2;return 0xFFFF;}
+        mask=(uint8_t)(1u<<(id&7));
+        if(visited[id>>3]&mask)continue;
+        visited[id>>3]|=mask;
+        return id;
+    }
+}
+static uint8_t read_line(uint16_t id)
+{
+    static uint16_t source;
+    source=(uint16_t)DdrMapRead(line_base+((uint16_t)id<<4));
+    if(!source){motion_state.fault=3;return 0;}
+    DoomCopy16(((uint32_t)(uint16_t)&current<<16)|source);
+    return 1;
+}
+
+uint8_t MotionTraceUse(int16_t end_x,int16_t end_y)
+{
+    static int16_t x,y,dx,dy,ex,ey,lx,hx,ly,hy;
+    static uint16_t id;
+    static int32_t den,t,u,side,fraction,best;
+    static uint8_t token;
+    x=motion_state.x>>16;y=motion_state.y>>16;dx=end_x-x;dy=end_y-y;
+    lx=((int32_t)(x<end_x ? x:end_x)-origin_x)>>7;
+    hx=((int32_t)(x>end_x ? x:end_x)-origin_x)>>7;
+    ly=((int32_t)(y<end_y ? y:end_y)-origin_y)>>7;
+    hy=((int32_t)(y>end_y ? y:end_y)-origin_y)>>7;
+    if(lx<0)lx=0;if(ly<0)ly=0;
+    if(hx>=map_width)hx=map_width-1;if(hy>=map_height)hy=map_height-1;
+    if(lx>hx || ly>hy)return 0;
+    scan_start(lx,hx,ly,hy);best=65537L;token=0;
+    while((id=scan_next())!=0xFFFF){
+        if(!read_line(id))return 0;
+        if(!current.use && !(current.flags&MOTION_LINE_SOLID) && current.top>motion_state.floor+MOTION_VIEW_HEIGHT)continue;
+        ex=current.x2-current.x1;ey=current.y2-current.y1;
+        den=(int32_t)dx*ey-(int32_t)dy*ex;
+        if(!den)continue;
+        side=((int32_t)x-current.x1)*ey-((int32_t)y-current.y1)*ex;
+        t=-side;u=((int32_t)current.x1-x)*dy-((int32_t)current.y1-y)*dx;
+        if(den<0){den=-den;t=-t;u=-u;}
+        if(t<0 || t>den || u<0 || u>den)continue;
+        fraction=FixedDiv(t,den);
+        if(fraction<best || (fraction==best && !current.use)){
+            best=fraction;token=side>=0 ? current.use:0;
+        }
+    }
+    return token;
+}
+
+/* Corner/line cross products fit int32 because asset loading bounds the map
+ * span to 16,384 units and coordinates away from int16 limits. Rounded boxes
+ * conservatively contain the fixed-point 32x32 player footprint. */
+static uint8_t blocked_line(int16_t left,int16_t right,int16_t bottom,int16_t top)
+{
+    static int16_t dx,dy,ax,ay,bx,by;
+    static int32_t lo,hi;
+    if(!(current.flags&(MOTION_LINE_SOLID|MOTION_LINE_HEIGHT_CHANGE)))return 0;
+    if (right <= (current.x1<current.x2 ? current.x1:current.x2) ||
+        left >= (current.x1>current.x2 ? current.x1:current.x2) ||
+        top <= (current.y1<current.y2 ? current.y1:current.y2) ||
+        bottom >= (current.y1>current.y2 ? current.y1:current.y2)) return 0;
+    dx=current.x2-current.x1;dy=current.y2-current.y1;
+    ax=dy>=0 ? left:right;bx=dy>=0 ? right:left;
+    ay=dx>=0 ? top:bottom;by=dx>=0 ? bottom:top;
+    lo=((int32_t)ax-current.x1)*dy-((int32_t)ay-current.y1)*dx;
+    hi=((int32_t)bx-current.x1)*dy-((int32_t)by-current.y1)*dx;
+    if(lo>0 || hi<0)return 0;
+    if ((current.flags & MOTION_LINE_SOLID) ||
+        current.bottom > query_floor+MOTION_STEP_HEIGHT ||
+        current.top < (current.bottom>query_floor ? current.bottom:query_floor)+MOTION_PLAYER_HEIGHT)return 1;
+    query_sector=1;
+    if(current.bottom>touch_floor)touch_floor=current.bottom;
+    if(current.top<touch_ceiling)touch_ceiling=current.top;
+    return 0;
+}
+
+static uint8_t try_move(int32_t x,int32_t y)
+{
+    static int16_t left,right,bottom,top,lx,hx,ly,hy;
+    static uint16_t id;
+    static int16_t floor,ceiling,next_centre_floor,next_centre_ceiling;
+    query_floor=actor_query ? motion_actor_floor:motion_state.floor;
+    left=(int16_t)(x>>16)-MOTION_PLAYER_RADIUS;
+    right=(int16_t)(x>>16)+MOTION_PLAYER_RADIUS+((uint16_t)x!=0);
+    bottom=(int16_t)(y>>16)-MOTION_PLAYER_RADIUS;
+    top=(int16_t)(y>>16)+MOTION_PLAYER_RADIUS+((uint16_t)y!=0);
+    lx=((int32_t)left-origin_x)>>7;hx=((int32_t)right-origin_x)>>7;
+    ly=((int32_t)bottom-origin_y)>>7;hy=((int32_t)top-origin_y)>>7;
+    if(lx<0 || ly<0 || hx>=map_width || hy>=map_height) return 0;
+    touch_floor=-32768;touch_ceiling=32767;query_sector=0;
+    scan_start(lx,hx,ly,hy);
+    while((id=scan_next())!=0xFFFF){
+        if(!read_line(id))return 0;
+        if(blocked_line(left,right,bottom,top))return 0;
+    }
+    if(motion_state.fault)return 0;
+    /* Keep the highest floor / lowest ceiling under the whole player box.
+     * A center-only floor snap gets stuck while straddling a downward step. */
+    if(query_sector || actor_query)MotionSectorAt(x,y,&floor,&ceiling);
+    else {floor=centre_floor;ceiling=centre_ceiling;}
+    next_centre_floor=floor;next_centre_ceiling=ceiling;
+    if(touch_floor>floor)floor=touch_floor;
+    if(touch_ceiling<ceiling)ceiling=touch_ceiling;
+    if((int32_t)ceiling-floor<MOTION_PLAYER_HEIGHT || (int32_t)floor-query_floor>MOTION_STEP_HEIGHT)return 0;
+    if(actor_query) {
+        if((int32_t)query_floor-floor>MOTION_STEP_HEIGHT)return 0;
+        motion_actor_floor=floor;return 1;
+    }
+    if(things_block && things_block(x>>16,y>>16))return 0;
+    centre_floor=next_centre_floor;centre_ceiling=next_centre_ceiling;
+    motion_state.x=x;motion_state.y=y;
+    motion_state.floor=floor;motion_state.ceiling=ceiling;
+    return 1;
+}
+
+/* A sequential collision query shares map caches, but never overwrites the
+ * player's coordinates, floor/ceiling or centre-sector cache. Ground actors
+ * currently have the same 16-unit radius and 56-unit height as the player. */
+uint8_t MotionActorMove(int16_t x,int16_t y,int16_t floor)
+{
+    static uint8_t accepted;
+    actor_query=1;motion_actor_floor=floor;
+    accepted=try_move((int32_t)x*65536L,(int32_t)y*65536L);
+    actor_query=0;
+    return accepted;
+}
+
+/* Horizontal sight segment against live wall/portal profiles. No host LOS. */
+uint8_t MotionVisible(int16_t x,int16_t y,int16_t endx,int16_t endy,int16_t eye)
+{
+    static uint16_t id;
+    static int16_t dx,dy,ex,ey;
+    static int32_t a,b;
+    dx=endx-x;dy=endy-y;
+    for(id=0;id<line_count;++id) {
+        if(!read_line(id))return 0;
+        if(!(current.flags&3))continue;
+        if(!(current.flags&1) && eye>=current.bottom && eye<current.top)continue;
+        if((x<current.x1 && endx<current.x1 && x<current.x2 && endx<current.x2) ||
+           (x>current.x1 && endx>current.x1 && x>current.x2 && endx>current.x2) ||
+           (y<current.y1 && endy<current.y1 && y<current.y2 && endy<current.y2) ||
+           (y>current.y1 && endy>current.y1 && y>current.y2 && endy>current.y2))continue;
+        ex=current.x2-current.x1;ey=current.y2-current.y1;
+        a=((int32_t)x-current.x1)*ey-((int32_t)y-current.y1)*ex;
+        b=((int32_t)endx-current.x1)*ey-((int32_t)endy-current.y1)*ex;
+        if((a>0 && b>0) || (a<0 && b<0))continue;
+        a=((int32_t)current.x1-x)*dy-((int32_t)current.y1-y)*dx;
+        b=((int32_t)current.x2-x)*dy-((int32_t)current.y2-y)*dx;
+        if((a>0 && b>0) || (a<0 && b<0))continue;
+        return 0;
+    }
+    return 1;
+}
+
+static void tick(void)
+{
+    static int16_t f,s,turn,angle;
+    static int32_t dx,dy,cosine,sine,x,y;
+    f=motion_input.forward;s=motion_input.strafe;turn=motion_input.turn;
+    if(f>MOTION_COMMAND_LIMIT)f=MOTION_COMMAND_LIMIT;
+    if(f< -MOTION_COMMAND_LIMIT)f= -MOTION_COMMAND_LIMIT;
+    if(s>MOTION_COMMAND_LIMIT)s=MOTION_COMMAND_LIMIT;
+    if(s< -MOTION_COMMAND_LIMIT)s= -MOTION_COMMAND_LIMIT;
+    if(turn>MOTION_TURN_LIMIT)turn=MOTION_TURN_LIMIT;
+    if(turn< -MOTION_TURN_LIMIT)turn= -MOTION_TURN_LIMIT;
+    motion_state.angle+=(uint32_t)((int32_t)turn*65536L);
+    ++motion_state.ticks;
+    DoorTick();
+    if(world_changed){
+        MotionSectorAt(motion_state.x,motion_state.y,&centre_floor,&centre_ceiling);
+        motion_state.ceiling=centre_ceiling;
+        world_changed=0;
+    }
+    if(!f && !s) return;
+    angle=(uint16_t)(motion_state.angle>>19);
+    cosine=finecosineapprox(angle);sine=finesineapprox(angle);
+    dx=FixedMul((int32_t)f*65536L,cosine)-FixedMul((int32_t)s*65536L,sine);
+    dy=FixedMul((int32_t)f*65536L,sine)+FixedMul((int32_t)s*65536L,cosine);
+    x=motion_state.x;y=motion_state.y;
+    if(try_move(x+dx,y+dy))return;
+    if(!dx || !dy){motion_state.blocked|=dx ? 1:2;return;}
+    if(dx && !try_move(x+dx,y))motion_state.blocked|=1;
+    if(dy && !try_move(motion_state.x,y+dy))motion_state.blocked|=2;
+}
+
+void MotionFrame(void)
+{
+    if(!motion_input.enabled){motion_state.enabled=0;motion_state.frame_ticks=0;return;}
+    motion_state.enabled=1;
+    motion_state.blocked=motion_state.frame_ticks=0;
+    if(motion_state.fault)return;
+    fraction+=MOTION_TICK_HZ;
+    while(fraction>=MOTION_FRAME_HZ){
+        fraction-=MOTION_FRAME_HZ;
+        tick();
+        ++motion_state.frame_ticks;
+        if(motion_state.fault)break;
+    }
+}
diff --git a/fw/doom/motion.h b/fw/doom/motion.h
new file mode 100644
index 0000000..74c111b
--- /dev/null
+++ b/fw/doom/motion.h
@@ -0,0 +1,49 @@
+/* Standalone player-motion bring-up, not the original Doom thinker/physics. */
+#ifndef DOOM_MOTION_H
+#define DOOM_MOTION_H
+#include "platform.h"
+#define MOTION_INPUT_BASE 0xF610
+#define MOTION_STATE_BASE 0xF6A0
+#define MOTION_LINES_BASE 0x00080010UL
+#define MOTION_BLOCKMAP_BASE 0x00090010UL
+#define MOTION_LINE_LIMIT 512
+#define MOTION_PLAYER_RADIUS 16
+#define MOTION_PLAYER_HEIGHT 56
+#define MOTION_STEP_HEIGHT 24
+#define MOTION_COMMAND_LIMIT 8
+#define MOTION_TURN_LIMIT 4096
+#define MOTION_TICK_HZ 35
+#define MOTION_FRAME_HZ 25
+#define MOTION_VIEW_HEIGHT 41
+#define MOTION_LINE_SOLID 1
+#define MOTION_LINE_HEIGHT_CHANGE 2
+
+typedef struct {
+    int16_t x1,y1,x2,y2,bottom,top;
+    uint8_t flags,front,back,use;
+} motion_line_t;
+typedef struct {
+    int8_t forward,strafe;
+    int16_t turn;
+    uint8_t enabled,buttons;
+} motion_input_t;
+typedef struct {
+    int32_t x,y;
+    uint32_t angle;
+    int16_t floor,ceiling;
+    uint32_t ticks;
+    uint8_t blocked,frame_ticks,fault,enabled;
+} motion_state_t;
+extern volatile __xdata __at(MOTION_INPUT_BASE) motion_input_t motion_input;
+extern volatile __xdata __at(MOTION_STATE_BASE) motion_state_t motion_state;
+void MotionInit(uint32_t lines,uint32_t blockmap,uint16_t count);
+void MotionFrame(void);
+uint8_t MotionActorMove(int16_t x,int16_t y,int16_t floor);
+uint8_t MotionVisible(int16_t x,int16_t y,int16_t endx,int16_t endy,int16_t eye);
+extern int16_t motion_actor_floor;
+void MotionSetThingsBlock(uint8_t (*check)(int16_t,int16_t));
+uint8_t MotionTraceUse(int16_t end_x,int16_t end_y);
+void MotionRefreshLine(uint16_t line);
+void MotionWorldChanged(void);
+void MotionSectorAt(int32_t x,int32_t y,int16_t *floor,int16_t *ceiling);
+#endif
diff --git a/fw/doom/platform.h b/fw/doom/platform.h
new file mode 100644
index 0000000..78b4e42
--- /dev/null
+++ b/fw/doom/platform.h
@@ -0,0 +1,46 @@
+/* Native SDCC/DW8051 platform. All DDR traffic uses MCU_DC port A. */
+#ifndef DOOM_PLATFORM_H
+#define DOOM_PLATFORM_H
+#include <stdint.h>
+#include "cache_config.h"
+
+int32_t FixedMul(int32_t a, int32_t b) __sdcccall(0);
+int32_t FixedDiv(int32_t a, int32_t b) __sdcccall(0);
+
+/* Generic pointer tags 1..63 are reserved by this executable for DDR.
+ * Objects must not cross a 64 KiB boundary or include offset zero. Normal SDCC XDATA, IDATA,
+ * PDATA and CODE tags retain their usual meanings. No hardware MMU is used.
+ * These routines and the pointer bridge are non-reentrant; no interrupts. */
+void *DdrPointer(uint32_t address);
+void DdrInit(void);
+void DdrFlush(void);
+uint8_t DdrRead(uint32_t address);
+void DdrWrite(uint32_t address, uint8_t value) __sdcccall(1);
+void DdrWriteBurst(uint32_t address);
+void DdrPresentRow(uint32_t address);
+void DdrPresentFrame(void);
+void DdrDrawColumn(uint8_t textured);
+uint16_t DoomReciprocalStep(uint32_t denominator);
+extern __xdata uint32_t doom_draw_address;
+extern __xdata uint8_t doom_draw_count, doom_draw_color;
+void DdrClearFrame(void);
+void DdrLoadColumn(uint32_t address);
+void DdrLoadColorMap(uint32_t address);
+void DdrGatherTile(uint32_t address);
+uint8_t __xdata *DdrMapWrite(uint32_t address);
+const uint8_t __xdata *DdrMapRead(uint32_t address);
+extern __xdata __at(DOOM_CACHE_BURST_BASE) uint8_t ddr_burst_buffer[DOOM_RGB_BLOCK_SIZE];
+/* One-long register ABI packs source pointer in the low word and target in
+ * the high word, avoiding mixed stack/register argument conventions. */
+void DoomCopy16(uint32_t pointers);
+void DoomTranspose16(uint32_t pointers);
+void DoomWrite16(uint16_t source);
+void DoomExpand16(uint16_t source);
+void DoomFillChunk(uint32_t count_color_target);
+uint16_t DoomShadeChunk(void);
+extern __xdata uint16_t doom_column_target, doom_column_frac, doom_column_step;
+extern __xdata uint8_t doom_column_count;
+extern __xdata uint8_t ddr_fault;
+extern __xdata uint32_t ddr_hits, ddr_misses;
+
+#endif
diff --git a/fw/doom/projectile_bank.asm b/fw/doom/projectile_bank.asm
new file mode 100644
index 0000000..2b1071a
--- /dev/null
+++ b/fw/doom/projectile_bank.asm
@@ -0,0 +1,39 @@
+; Native bank trampolines. The same wrapper bytes exist in both code banks.
+; ABI 1: Spawn's uint16 owner arrives in DPTR. No interrupts in this image.
+.module projectile_bank
+.globl _ProjectileInit,_ProjectileSpawn,_ProjectileTick
+.area CSEG (CODE)
+_ProjectileInit:
+    mov r7,#0
+    sjmp enter
+_ProjectileSpawn:
+    mov r7,#1
+    sjmp enter
+_ProjectileTick:
+    mov r7,#2
+enter:
+    push dpl
+    push dph
+    mov dptr,#0xffff
+    mov a,#1
+    movx @dptr,a
+    pop dph
+    pop dpl
+    mov a,r7
+    jz init
+    cjne a,#1,tick
+    lcall 0x5003
+    sjmp leave
+init:
+    lcall 0x5000
+    sjmp leave
+tick:
+    lcall 0x5006
+leave:
+    mov dptr,#0xffff
+    clr a
+    movx @dptr,a
+    ret
+.area CABS (ABS,CODE)
+.org 0xff94
+.dw 16,8
diff --git a/fw/doom/projectiles.c b/fw/doom/projectiles.c
new file mode 100644
index 0000000..0f6e7ef
--- /dev/null
+++ b/fw/doom/projectiles.c
@@ -0,0 +1,73 @@
+/* Eight bounded native fireballs. Fixed trajectory; no host steering/rendering. */
+#include "actor_types.h"
+#include "motion.h"
+extern static_thing_t *actor_things;
+extern uint16_t actor_count;
+void PlayerDamage(uint8_t damage) __sdcccall(1);
+typedef struct {int32_t x,y;int16_t vx,vy;uint16_t age,owner;} projectile_t;
+volatile __xdata __at(0xF720) uint16_t projectile_info[8];
+__code __at(0xFF94) const uint16_t projectile_schema[]={sizeof(projectile_t),8};
+static projectile_t *projectile_states;
+static static_thing_t *projectile_sprites;
+void ProjectileInit(void) __sdcccall(1)
+{
+    static uint8_t i;
+    static uint16_t *header;
+    header=DdrPointer(0xD0010UL);header[1]=actor_count+8;
+    projectile_states=DdrPointer(0xD6010UL);
+    projectile_sprites=actor_things+actor_count;
+    for(i=0;i<8;++i){projectile_info[i]=0;projectile_sprites[i].health=0;}
+}
+void ProjectileSpawn(uint16_t owner) __sdcccall(1)
+{
+    static uint8_t i;
+    static int16_t dx,dy,den;
+    static projectile_t *p;
+    static static_thing_t *v;
+    static const uint16_t *header;
+    for(i=0;i<8;++i)if(!projectile_sprites[i].health)break;
+    if(i==8){++projectile_info[6];return;}
+    p=projectile_states+i;v=projectile_sprites+i;
+    v->x=actor_things[owner].x;v->y=actor_things[owner].y;
+    v->floor=actor_things[owner].floor+32;
+    p->x=(int32_t)v->x*65536L;p->y=(int32_t)v->y*65536L;
+    dx=(motion_state.x>>16)-v->x;dy=(motion_state.y>>16)-v->y;
+    den=dx<0 ? -dx:dx;if((dy<0 ? -dy:dy)>den)den=dy<0 ? -dy:dy;
+    if(!den)return;
+    p->vx=FixedDiv(dx,den)>>5;p->vy=FixedDiv(dy,den)>>5;
+    p->age=0;p->owner=owner;
+    header=DdrPointer(0xD0010UL);v->kind=header[2];
+    v->angle=v->tics=0;v->frame=0;v->awake=1;v->health=1;
+    ++projectile_info[0];
+}
+void ProjectileTick(void) __sdcccall(1)
+{
+    static uint8_t i,step;
+    static int16_t x,y,nx,ny,dx,dy;
+    static projectile_t *p;
+    static static_thing_t *v;
+    projectile_info[7]=0;
+    for(i=0;i<8;++i) {
+        v=projectile_sprites+i;if(!v->health)continue;
+        ++projectile_info[7];p=projectile_states+i;
+        if(v->awake==2) {
+            if(++v->tics>=4){v->tics=0;if(++v->frame>4)v->health=0;}
+            continue;
+        }
+        if(++p->age>105){v->health=0;++projectile_info[5];continue;}
+        v->frame=(p->age>>2)&1;
+        for(step=0;step<4;++step) {
+            x=p->x>>16;y=p->y>>16;
+            p->x+=(int32_t)p->vx*64L;p->y+=(int32_t)p->vy*64L;
+            nx=p->x>>16;ny=p->y>>16;
+            if(!MotionVisible(x,y,nx,ny,v->floor)) {
+                v->awake=2;v->frame=2;v->tics=0;++projectile_info[2];break;
+            }
+            v->x=nx;v->y=ny;++projectile_info[1];
+            dx=nx-(int16_t)(motion_state.x>>16);dy=ny-(int16_t)(motion_state.y>>16);
+            if(dx>=-20 && dx<=20 && dy>=-20 && dy<=20 && v->floor>=motion_state.floor && v->floor<motion_state.floor+56) {
+                PlayerDamage(10);v->awake=2;v->frame=2;v->tics=0;++projectile_info[3];break;
+            }
+        }
+    }
+}
diff --git a/fw/doom/renderer_port.c b/fw/doom/renderer_port.c
new file mode 100644
index 0000000..67dd372
--- /dev/null
+++ b/fw/doom/renderer_port.c
@@ -0,0 +1,194 @@
+/* First native Doom8088 renderer integration: walls, BSP and flat planes.
+ * Assets are preloaded into DDR. Native movement/collision, manual doors and animated ground actors; no original game thinkers.
+ * Engine code and licences: vendor/Doom8088, commit b3073a2e. */
+#include "platform.h"
+#include "motion.h"
+#include "doors.h"
+#include "globdata.h"
+#include <stddef.h>
+__sfr __at(DOOM_SFR_CKCON) doom_ckcon;
+
+const seg_t *_g_segs;
+int16_t _g_numsectors, _g_numlines;
+sector_t *_g_sectors;
+subsector_t *_g_subsectors;
+line_t *_g_lines;
+side_t *_g_sides;
+uint16_t _g_gamma;
+int32_t _g_gametic = 1;
+player_t _g_player;
+int16_t skyflatnum = -2;
+static mobj_t camera;
+static uint8_t *screen, *palette;
+static const texture_t *textures;
+static const uint32_t *texture_pixels;
+static __xdata __at(DOOM_CACHE_PALETTE_BASE) uint8_t palette_xram[DOOM_PALETTE_BYTES];
+__xdata uint16_t doom_column_target, doom_column_frac, doom_column_step;
+__xdata uint8_t doom_column_count;
+
+typedef struct {
+    uint32_t segs, sectors, subsectors, lines, sides, nodes;
+    uint32_t textureinfo, texturepixels, heights, translations, palette;
+    int16_t nodecount, sectorcount, linecount;
+    int32_t x, y;
+    uint32_t angle;
+    int32_t viewz;
+    uint32_t collisionlines,blockmap,doors;
+} boot_t;
+volatile __xdata __at(0xF640) boot_t renderer_boot;
+volatile __xdata __at(0xF600) uint8_t renderer_status[16];
+volatile __xdata __at(0xF630) uint8_t renderer_frames;
+volatile __xdata __at(0xF631) uint8_t renderer_ack;
+volatile __xdata __at(0xF632) uint8_t renderer_frames_hi;
+volatile __xdata __at(0xF634) uint32_t renderer_angle_step;
+
+/* Read by the asset packer from the linked image, so host C layout and pointer
+ * width cannot silently differ from SDCC. Values are little-endian uint16_t. */
+#define O(T,F) offsetof(T,F)
+__code __at(0xFF00) const uint16_t renderer_schema[] = {
+    sizeof(sector_t), O(sector_t,floorheight), O(sector_t,ceilingheight),
+    O(sector_t,floorpic), O(sector_t,ceilingpic), O(sector_t,lightlevel),
+    sizeof(side_t), O(side_t,sector), O(side_t,textureoffset), O(side_t,rowoffset),
+    O(side_t,toptexture), O(side_t,bottomtexture), O(side_t,midtexture),
+    sizeof(line_t), O(line_t,v1), O(line_t,v2), O(line_t,dx), O(line_t,dy),
+    O(line_t,sidenum), O(line_t,bbox), O(line_t,flags), O(line_t,r_validcount),
+    sizeof(subsector_t), O(subsector_t,sector), O(subsector_t,numlines), O(subsector_t,firstline),
+    sizeof(texture_t), O(texture_t,widthmask), O(texture_t,width), O(texture_t,height),
+    sizeof(seg_t), sizeof(mapnode_t), sizeof(boot_t),
+    sizeof(motion_line_t), sizeof(motion_input_t), sizeof(motion_state_t),
+    sizeof(door_def_t), sizeof(door_state_t)
+};
+
+void R_PlatformInit(void);
+void R_ActorFrame(void);
+void R_ActorInit(void);
+void R_CombatInit(void);
+uint8_t R_PlayerAlive(void);
+void R_DrawCombatHUD(void);
+__code __at(0xFFF0) const uint8_t renderer_format[] = {'D','8','0','5',5};
+/* The renderer uses stack arguments; the non-reentrant cache uses ABI 1. */
+void DdrWriteStack(uint32_t address, uint8_t value);
+const texture_t *R_GetTexture(int16_t n) { return textures + n; }
+static uint32_t pointer_address(const uint8_t *p)
+{
+    union { const uint8_t *p; uint8_t b[3]; } u;
+    u.p = p;
+    return ((uint32_t)u.b[2] << 16) | ((uint16_t)u.b[1] << 8) | u.b[0];
+}
+void R_PlatformTexture(int16_t n, int16_t col, draw_column_vars_t *dc)
+{
+    const texture_t *tex = textures + n;
+    DdrLoadColumn(texture_pixels[n] + ((uint32_t)(col & tex->widthmask) << 7));
+    DdrLoadColorMap(pointer_address(dc->colormap));
+    R_DrawColumnWall(dc);
+}
+
+/* Column-major indexed storage makes each vertical draw contiguous in DDR. */
+void R_DrawColumnWall(const draw_column_vars_t *dc)
+{
+    static int16_t count;
+    count = dc->yh - dc->yl + 1;
+    if (count <= 0) return;
+    doom_column_frac = (dc->texturemid >> 7) + (dc->yl - VIEWWINDOWHEIGHT / 2) * dc->fracstep;
+    doom_column_step = dc->fracstep;
+    doom_draw_address = DOOM_INDEXED_BASE + dc->x * DOOM_TEXTURE_COLUMN_SIZE + dc->yl;
+    doom_draw_count = count;
+    DdrDrawColumn(1);
+}
+void R_DrawColumnFlat(uint8_t color, const draw_column_vars_t *dc)
+{
+    static int16_t count;
+    count = dc->yh - dc->yl + 1;
+    if (count <= 0) return;
+    doom_draw_address = DOOM_INDEXED_BASE + dc->x * DOOM_TEXTURE_COLUMN_SIZE + dc->yl;
+    doom_draw_count = count;
+    doom_draw_color = color;
+    DdrDrawColumn(0);
+}
+byte R_GetPlaneColor(int16_t picnum, int16_t lightlevel)
+{
+    return R_LoadColorMap(lightlevel)[picnum < 0 ? 122 : picnum];
+}
+void R_LoadSkyPatch(void) { }
+void R_FreeSkyPatch(void) { }
+void R_DrawSky(draw_column_vars_t *dc) { R_DrawColumnFlat(99, dc); }
+
+void MotionSectorAt(int32_t x,int32_t y,int16_t *floor,int16_t *ceiling)
+{
+    sector_t *sector=R_PointInSubsector(x,y)->sector;
+    *floor=sector->floorheight>>16;
+    *ceiling=sector->ceilingheight>>16;
+}
+
+int16_t DoorSectorCeiling(uint16_t sector) {return _g_sectors[sector].ceilingheight>>16;}
+void DoorSetCeiling(uint16_t sector,int16_t height) {_g_sectors[sector].ceilingheight=(int32_t)height*65536L;}
+
+void main(void)
+{
+    static uint16_t i;
+    static uint16_t frames;
+    /* Match the SDK's _CKCON_MOVX_DEFAULT_CYCLE = _CKCON_MOVX_2_CYCLE. */
+    doom_ckcon = (doom_ckcon & ~DOOM_MOVX_MASK) | DOOM_MOVX_DEFAULT;
+    renderer_status[0] = 1;
+    DdrInit();
+    R_PlatformInit();
+    _g_segs = DdrPointer(renderer_boot.segs);
+    _g_sectors = DdrPointer(renderer_boot.sectors);
+    _g_subsectors = DdrPointer(renderer_boot.subsectors);
+    _g_lines = DdrPointer(renderer_boot.lines);
+    _g_sides = DdrPointer(renderer_boot.sides);
+    nodes = DdrPointer(renderer_boot.nodes);
+    numnodes = renderer_boot.nodecount;
+    _g_numsectors = renderer_boot.sectorcount;
+    _g_numlines = renderer_boot.linecount;
+    textures = DdrPointer(renderer_boot.textureinfo);
+    texture_pixels = DdrPointer(renderer_boot.texturepixels);
+    textureheight = DdrPointer(renderer_boot.heights);
+    texturetranslation = DdrPointer(renderer_boot.translations);
+    palette = DdrPointer(renderer_boot.palette);
+    screen = DdrPointer(DOOM_INDEXED_BASE);
+    for (i = 0; i != 256; ++i) {
+        palette_xram[i] = palette[i * 3 + 2];
+        palette_xram[i + 256] = palette[i * 3 + 1];
+        palette_xram[i + 512] = palette[i * 3];
+    }
+    camera.x = renderer_boot.x;
+    camera.y = renderer_boot.y;
+    camera.angle = renderer_boot.angle;
+    _g_player.mo = &camera;
+    _g_player.viewz = renderer_boot.viewz;
+    motion_state.x=camera.x;motion_state.y=camera.y;motion_state.angle=camera.angle;
+    MotionSectorAt(camera.x,camera.y,(int16_t *)&motion_state.floor,(int16_t *)&motion_state.ceiling);
+    MotionInit(renderer_boot.collisionlines,renderer_boot.blockmap,renderer_boot.linecount);
+    DoorInit(renderer_boot.doors);
+    R_ActorInit();
+    R_CombatInit();
+    frames = ((uint16_t)renderer_frames_hi<<8)|renderer_frames;
+    if (!frames) frames = 1;
+    do {
+        renderer_status[0] = 2;
+        if(R_PlayerAlive()) MotionFrame();
+        else {motion_state.enabled=motion_input.enabled;motion_state.frame_ticks=0;}
+        if(motion_state.enabled) {
+            camera.x=motion_state.x;camera.y=motion_state.y;camera.angle=motion_state.angle;
+            _g_player.viewz=((int32_t)motion_state.floor+MOTION_VIEW_HEIGHT)*65536L;
+        }
+        R_ActorFrame();
+        renderer_status[0] = 4;
+        DdrClearFrame();
+        R_RenderPlayerView(&_g_player);
+        R_DrawCombatHUD();
+        renderer_status[0] = 3;
+        DdrPresentFrame();
+        DdrFlush();
+        renderer_status[1] = ddr_fault ? ddr_fault : (motion_state.fault ? motion_state.fault : door_info.fault);
+        if (--frames) {
+            renderer_ack = 0;
+            renderer_status[0] = 0xA4;
+            while (!renderer_ack) { }
+            ++_g_gametic;
+            if(!motion_input.enabled) {camera.angle += renderer_angle_step;motion_state.angle=camera.angle;}
+        } else renderer_status[0] = 0xA5;
+    } while (frames);
+    for (;;) { }
+}
diff --git a/fw/doom/sprites.inc b/fw/doom/sprites.inc
new file mode 100644
index 0000000..843ba44
--- /dev/null
+++ b/fw/doom/sprites.inc
@@ -0,0 +1,94 @@
+/* Standalone ground actors. Native movement, animation, projection and clips.
+ * WAD conversion is offline. Standalone combat is separate from the original Doom thinker system. */
+#include "motion.h"
+#include "actor_types.h"
+__code __at(0xFF80) const uint16_t sprite_schema[] = {sizeof(static_thing_t),sizeof(static_patch_t),2};
+volatile __xdata __at(0xF6D0) uint16_t sprite_info[4];
+static void R_StaticSprites(void)
+{
+    static static_thing_t *things,*thing;
+    static const static_patch_t *patches,*patch;
+    static const uint16_t *header;
+    static const uint8_t *shade;
+    static const drawseg_t *ds;
+    static sector_t *sector;
+    static uint8_t *dest;
+    static uint16_t count,monsters,i,best,rot;
+    static int16_t x,x1,x2,y,y1,y2,sx,sy,cliptop,clipbot,floor,light;
+    static int32_t dx,dy,tx,tz,scale,xscale,left,top,stepx,stepy,u,v,maxdepth;
+    static uint32_t address;
+    static uint8_t color;
+    header=DdrPointer(0xD0010UL);things=DdrPointer(0xD0020UL);patches=DdrPointer(0xE0010UL);
+    monsters=header[0];count=header[1];
+    if(count>136) {ddr_fault=5;return;}
+    sprite_info[0]=count;sprite_info[1]=0;sprite_info[2]=0;sprite_info[3]=0;
+    for(i=0;i<count;++i) {
+        thing=things+i;
+        if(i>=monsters && !thing->health){thing->depth=0;continue;}
+        dx=(int32_t)thing->x*65536L-viewx;dy=(int32_t)thing->y*65536L-viewy;
+        tz=FixedMul(dx,viewcos)+FixedMul(dy,viewsin);
+        tx=FixedMul(dx,viewsin)-FixedMul(dy,viewcos);
+        if(tz<4L*65536L || tz>1280L*65536L || tx>tz*2 || tx< -tz*2) tz=0;
+        else ++sprite_info[1];
+        thing->depth=tz;
+    }
+    /* Back to front selection in DDR keeps MCU SRAM bounded. */
+    for(;;) {
+        maxdepth=0;best=count;
+        for(i=0;i<count;++i) {
+            tz=things[i].depth;
+            if(tz>maxdepth) {maxdepth=tz;best=i;}
+        }
+        if(best==count) break;
+        thing=things+best;thing->depth=0;tz=maxdepth;
+        dx=(int32_t)thing->x*65536L;dy=(int32_t)thing->y*65536L;
+        rot=(uint16_t)(R_PointToAngle16(thing->x,thing->y)-thing->angle+0x9000U)>>13;
+        patch=patches+thing->kind*96+(uint16_t)thing->frame*8+rot;
+        if(!patch->width) continue;
+        sector=R_PointInSubsector(dx,dy)->sector;
+        floor=sector->floorheight>>16;light=sector->lightlevel;
+        if(best>=monsters){floor=thing->floor;light=255;}
+        tx=FixedMul(dx-viewx,viewsin)-FixedMul(dy-viewy,viewcos);
+        xscale=PROJECTION/(tz>>16);scale=((int32_t)DOOM_VIEW_HEIGHT*65536L)/(tz>>16);
+        tx-=(int32_t)(patch->flip ? patch->width-patch->left : patch->left)*65536L;
+        left=(int32_t)CENTERX*65536L+FixedMul(tx,xscale);
+        x1=left>>16;
+        x2=((int32_t)CENTERX*65536L+FixedMul(tx+(int32_t)patch->width*65536L,xscale)-1)>>16;
+        if(x1>=VIEWWINDOWWIDTH || x2<0 || x2<x1) continue;
+        if(x1<0)x1=0;if(x2>=VIEWWINDOWWIDTH)x2=VIEWWINDOWWIDTH-1;
+        top=(int32_t)CENTERY*65536L-FixedMul(((int32_t)floor+patch->top)*65536L-viewz,scale);
+        y1=top>>16;y2=(top+FixedMul((int32_t)patch->height*65536L,scale)-1)>>16;
+        if(y1>=DOOM_VIEW_HEIGHT || y2<0)continue;
+        if(y1<0)y1=0;if(y2>=DOOM_VIEW_HEIGHT)y2=DOOM_VIEW_HEIGHT-1;
+        stepx=FixedDiv(65536L,xscale);stepy=FixedDiv(65536L,scale);
+        curline=0;shade=R_LoadColorMap(light);
+        ++sprite_info[2];
+        u=FixedMul((int32_t)x1*65536L-left,stepx);
+        for(x=x1;x<=x2;++x,u+=stepx) {
+            cliptop=-1;clipbot=DOOM_VIEW_HEIGHT;
+            for(ds=_s_drawsegs;ds<ds_p;++ds) {
+                if(x<ds->x1 || x>ds->x2 || !ds->silhouette) continue;
+                if(ds->scale1+(int32_t)(x-ds->x1)*ds->scalestep<scale)continue;
+                if((ds->silhouette&2) && ((int32_t)floor+patch->top)*65536L>ds->tsilheight) {
+                    if(ds->sprtopclip[x]>cliptop)cliptop=ds->sprtopclip[x];
+                }
+                if((ds->silhouette&1) && (int32_t)floor*65536L<ds->bsilheight) {
+                    if(ds->sprbottomclip[x]<clipbot)clipbot=ds->sprbottomclip[x];
+                }
+            }
+            sx=u>>16;
+            if(sx<0 || sx>=patch->width)continue;
+            if(patch->flip)sx=patch->width-1-sx;
+            address=patch->pixels+(uint32_t)sx*256UL;
+            dest=DdrPointer(DOOM_INDEXED_BASE+(uint16_t)x*128U);
+            v=FixedMul((int32_t)y1*65536L-top,stepy);
+            for(y=y1;y<=y2;++y,v+=stepy) {
+                if(y<=cliptop || y>=clipbot)continue;
+                sy=v>>16;
+                if(sy<0 || sy>=patch->height)continue;
+                if(!DdrRead(address+(uint16_t)sy*2U+1))continue;
+                color=DdrRead(address+(uint16_t)sy*2U);dest[y]=shade[color];++sprite_info[3];
+            }
+        }
+    }
+}

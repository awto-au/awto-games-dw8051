+rr a
+orl a,r3
+movx @dptr,a
+mov dptr,#DOOM_MCU_DC_LEN
+mov a,#(DOOM_DDR_BURST_BYTES / 8)
+movx @dptr,a
+ret
+
+counter:
+movx a,@dptr
+add a,#1
+movx @dptr,a
+jnc count_done
+inc dptr
+movx a,@dptr
+addc a,#0
+movx @dptr,a
+jnc count_done
+inc dptr
+movx a,@dptr
+addc a,#0
+movx @dptr,a
+jnc count_done
+inc dptr
+movx a,@dptr
+addc a,#0
+movx @dptr,a
+count_done:
+ret
diff --git a/fw/doom/combat.inc b/fw/doom/combat.inc
new file mode 100644
index 0000000..833f887
--- /dev/null
+++ b/fw/doom/combat.inc
@@ -0,0 +1,79 @@
+/* Standalone deterministic combat. Not vanilla Doom rules. */
+#define HUD_KEY_BLUE_INDEX 200
+#define HUD_KEY_YELLOW_INDEX 160
+#define HUD_KEY_RED_INDEX 176
+void ProjectileInit(void) __sdcccall(1);
+void ProjectileSpawn(uint16_t owner) __sdcccall(1);
+void PickupInit(void) __sdcccall(1);
+volatile __xdata __at(0xF740) uint16_t pickup_info[4];
+volatile __xdata __at(0xF700) combat_state_t combat;
+volatile __xdata __at(0xF71E) uint8_t combat_hud;
+__code __at(0xFF90) const uint16_t combat_schema[] = {sizeof(combat_state_t)};
+void R_CombatInit(void)
+{
+    combat.health=100;combat.ammo=50;
+    combat.shots=combat.hits=combat.kills=combat.damage=combat.attacks=combat.dead=0;
+    combat.wait=combat.flash=combat.hurt=combat.spare=0;combat.target=0;
+    ProjectileInit();
+    PickupInit();
+}
+uint8_t R_PlayerAlive(void) {return combat.health!=0;}
+static void CombatTick(void)
+{
+    static uint16_t i,best;
+    static int16_t x,y,depth,side,nearest,angle;
+    static int32_t dx,dy,c,s;
+    if(combat.wait)--combat.wait;
+    if(combat.flash)--combat.flash;
+    if(combat.hurt)--combat.hurt;
+    if(!(motion_input.buttons&2) || combat.wait || !combat.ammo || !combat.health)return;
+    --combat.ammo;++combat.shots;combat.wait=7;combat.flash=3;combat.target=0;
+    x=motion_state.x>>16;y=motion_state.y>>16;angle=motion_state.angle>>19;
+    c=finecosineapprox(angle);s=finesineapprox(angle);nearest=1025;best=actor_count;
+    for(i=0;i<actor_count;++i) {
+        if(!actor_things[i].health)continue;
+        dx=((int32_t)actor_things[i].x-x)*65536L;dy=((int32_t)actor_things[i].y-y)*65536L;
+        depth=(FixedMul(dx,c)+FixedMul(dy,s))>>16;
+        side=(FixedMul(dy,c)-FixedMul(dx,s))>>16;
+        if(depth<=0 || depth>=nearest || side< -16 || side>16)continue;
+        if(motion_state.floor+41<actor_things[i].floor || motion_state.floor+41>=actor_things[i].floor+56)continue;
+        if(!MotionVisible(x,y,actor_things[i].x,actor_things[i].y,motion_state.floor+41))continue;
+        nearest=depth;best=i;
+    }
+    if(best==actor_count)return;
+    combat.target=best+1;++combat.hits;actor_things[best].awake=1;actor_things[best].tics=0;
+    if(actor_things[best].health<=20) {
+        actor_things[best].health=0;actor_things[best].frame=7;++combat.kills;
+    } else {actor_things[best].health-=20;actor_things[best].frame=6;}
+}
+void PlayerDamage(uint8_t damage) __sdcccall(1)
+{
+    if(!combat.health)return;
+    combat.health=combat.health>damage ? combat.health-damage:0;
+    combat.damage+=damage;combat.hurt=5;
+    if(!combat.health)combat.dead=1;
+}
+static void CombatAttack(uint16_t id)
+{
+    static int16_t x,y,z,dx,dy;
+    static const uint16_t *kinds;
+    ++combat.attacks;
+    x=actor_things[id].x;y=actor_things[id].y;z=actor_things[id].floor+32;
+    dx=x-(int16_t)(motion_state.x>>16);dy=y-(int16_t)(motion_state.y>>16);
+    if(dx< -512 || dx>512 || dy< -512 || dy>512 || !combat.health)return;
+    kinds=DdrPointer(0xD3010UL);
+    if(dx>=-48 && dx<=48 && dy>=-48 && dy<=48) {
+        z=motion_state.floor+41;
+        if(z<actor_things[id].floor || z>=actor_things[id].floor+56)return;
+        if(MotionVisible(x,y,motion_state.x>>16,motion_state.y>>16,z))PlayerDamage(10);
+        return;
+    }
+    if(kinds[actor_things[id].kind]==2)return;
+    if(kinds[actor_things[id].kind]) {
+        if(MotionVisible(x,y,motion_state.x>>16,motion_state.y>>16,z))ProjectileSpawn(id);
+    } else {
+        z=motion_state.floor+41;
+        if(z<actor_things[id].floor || z>=actor_things[id].floor+56)return;
+        if(MotionVisible(x,y,motion_state.x>>16,motion_state.y>>16,z))PlayerDamage(10);
+    }
+}
diff --git a/fw/doom/ddr_cache.c b/fw/doom/ddr_cache.c
new file mode 100644
index 0000000..fc62fb4
--- /dev/null
+++ b/fw/doom/ddr_cache.c
@@ -0,0 +1,51 @@
+/* Cache metadata and block operations. Native DW8051 assembly implements
+ * cache misses, dirty eviction and the real MCU_DC port transactions. */
+#include "platform.h"
+uint8_t DdrStore(uint8_t index);
+void DdrWriteRaw(uint32_t addr);
+__xdata __at(DOOM_CACHE_DATA_BASE) uint8_t ddr_cache_data[DOOM_CACHE_LINES * DOOM_DDR_BURST_BYTES];
+__xdata __at(DOOM_CACHE_OFFSETS_BASE) uint16_t ddr_cache_offsets[DOOM_CACHE_LINES];
+__xdata __at(DOOM_CACHE_BANKS_BASE) uint16_t ddr_cache_banks[DOOM_CACHE_LINES];
+__xdata __at(DOOM_CACHE_BURST_BASE) uint8_t ddr_burst_buffer[DOOM_RGB_BLOCK_SIZE];
+__xdata __at(DOOM_FRAME_BITMAP_BASE) uint8_t doom_frame_bitmap[DOOM_FRAME_BITMAP_BYTES];
+__xdata uint8_t doom_frame_active;
+__xdata uint8_t ddr_fault;
+__xdata uint32_t doom_draw_address;
+__xdata uint8_t doom_draw_count, doom_draw_color;
+/* Explicit cache API calls only; hot generic-pointer hits avoid counters. */
+__xdata uint32_t ddr_hits, ddr_misses;
+__xdata uint16_t doom_burst_source;
+__xdata uint32_t doom_colormap_address, doom_texture_address;
+
+void DdrInit(void)
+{
+    uint8_t i;
+    ddr_fault = 0;
+    doom_frame_active = 0;
+    ddr_hits = ddr_misses = 0;
+    doom_colormap_address = 0;
+    doom_texture_address = 0;
+    for (i = 0; i != DOOM_CACHE_LINES; ++i) ddr_cache_banks[i] = 0;
+}
+
+void DdrFlush(void)
+{
+    uint8_t i;
+    for (i = 0; i != DOOM_CACHE_LINES; ++i) if (!DdrStore(i)) return;
+}
+
+void DdrWriteBurst(uint32_t addr)
+{
+    doom_burst_source = DOOM_CACHE_BURST_BASE;
+    DdrWriteRaw(addr);
+}
+
+void *DdrPointer(uint32_t addr)
+{
+    union { uint8_t bytes[3]; void *ptr; } p;
+    if (addr < 0x10000UL || addr >= 0x400000UL || !(uint16_t)addr) { ddr_fault = 4; return 0; }
+    p.bytes[0] = addr;
+    p.bytes[1] = addr >> 8;
+    p.bytes[2] = addr >> 16;
+    return p.ptr;
+}
diff --git a/fw/doom/ddr_pointer.asm b/fw/doom/ddr_pointer.asm
new file mode 100644
index 0000000..592fc8b
--- /dev/null
+++ b/fw/doom/ddr_pointer.asm
@@ -0,0 +1,274 @@
+; Generic pointer bridge, SDCC large model, register bank zero, no interrupts.
+; Tags 01..3f access DDR through the native cache. Normal SDCC tags preserved.
+; Preserve all registers, DPTR, B and PSW, except the documented ACC result.
+.module doom_ddr_pointer
+.include "doom_cache_config.inc"
+.globl __gptrget, __gptrput
+.globl _DdrRead, _DdrWrite
+acc = 0xe0
+b = 0xf0
+psw = 0xd0
+dpl1 = 0x84
+dph1 = 0x85
+dps = 0x86
+.area CSEG (CODE)
+__gptrget:
+push psw
+mov a,b
+jz get_xram
+jb acc.7,get_code
+cjne a,#0x40,get_pdata_test
+push 0x00
+mov r0,dpl
+mov a,@r0
+pop 0x00
+pop psw
+ret
+get_pdata_test:
+cjne a,#0x60,get_ddr
+push 0x00
+mov r0,dpl
+movx a,@r0
+pop 0x00
+pop psw
+ret
+get_code:
+clr a
+movc a,@a+dptr
+pop psw
+ret
+get_xram:
+movx a,@dptr
+pop psw
+ret
+get_ddr:
+jnb acc.6,get_valid_ddr
+ljmp bad_tag
+get_valid_ddr:
+; DPTR0 and B keep the generic address. DPTR1 probes the SRAM cache.
+push 0x00
+push 0x01
+push dps
+push dpl1
+push dph1
+lcall lookup
+jnc get_fast_miss
+mov dpl1,dpl
+mov a,dph
+anl a,#0x07
+add a,#(DOOM_CACHE_DATA_BASE >> 8)
+mov dph1,a
+movx a,@dptr
+pop dph1
+pop dpl1
+pop dps
+pop 0x01
+pop 0x00
+pop psw
+ret
+get_fast_miss:
+pop dph1
+pop dpl1
+pop dps
+pop 0x01
+pop 0x00
+lcall save
+clr a
+lcall _DdrRead
+mov a,dpl
+ljmp restore
+__gptrput:
+push psw
+push acc
+mov a,b
+jz put_xram
+jnb acc.7,put_not_code
+ljmp bad_tag
+put_not_code:
+cjne a,#0x40,put_pdata_test
+pop acc
+push 0x00
+mov r0,dpl
+mov @r0,a
+pop 0x00
+pop psw
+ret
+put_pdata_test:
+cjne a,#0x60,put_ddr
+pop acc
+push 0x00
+mov r0,dpl
+movx @r0,a
+pop 0x00
+pop psw
+ret
+put_xram:
+pop acc
+movx @dptr,a
+pop psw
+ret
+put_ddr:
+jnb acc.6,put_valid_ddr
+ljmp bad_tag
+put_valid_ddr:
+pop acc
+push acc
+push 0x00
+push 0x01
+push dps
+push dpl1
+push dph1
+lcall lookup
+jnc put_fast_miss
+; A matching generic bank is below 4 MiB, so bank bit 8 is zero.
+mov a,#((DOOM_CACHE_VALID | DOOM_CACHE_DIRTY) >> 8)
+movx @dptr,a
+mov dpl1,dpl
+mov a,dph
+anl a,#0x07
+add a,#(DOOM_CACHE_DATA_BASE >> 8)
+mov dph1,a
+mov a,sp
+add a,#0xfb
+mov r1,a
+mov a,@r1
+movx @dptr,a
+pop dph1
+pop dpl1
+pop dps
+pop 0x01
+pop 0x00
+pop acc
+pop psw
+ret
+put_fast_miss:
+pop dph1
+pop dpl1
+pop dps
+pop 0x01
+pop 0x00
+pop acc
+; Inline saves: a subroutine cannot leave its return address under the frame.
+push acc
+push 0x00
+push 0x01
+push 0x02
+push 0x03
+push 0x04
+push 0x05
+push 0x06
+push 0x07
+push dpl
+push dph
+push b
+push psw
+mov r7,a
+clr a
+lcall _DdrWrite
+lcall restore_put
+pop acc
+pop psw
+ret
+bad_tag:
+sjmp bad_tag
+
+; save/restore must move their own return address around the saved frame.
+save:
+pop acc
+mov save_ret_lo,a
+pop acc
+mov save_ret_hi,a
+push 0x00
+push 0x01
+push 0x02
+push 0x03
+push 0x04
+push 0x05
+push 0x06
+push 0x07
+push dpl
+push dph
+push b
+push psw
+push save_ret_hi
+push save_ret_lo
+ret
+restore_put:
+pop acc
+mov save_ret_lo,a
+pop acc
+mov save_ret_hi,a
+pop psw
+pop b
+pop dph
+pop dpl
+pop 0x07
+pop 0x06
+pop 0x05
+pop 0x04
+pop 0x03
+pop 0x02
+pop 0x01
+pop 0x00
+push save_ret_hi
+push save_ret_lo
+ret
+restore:
+pop psw
+pop b
+pop dph
+pop dpl
+pop 0x07
+pop 0x06
+pop 0x05
+pop 0x04
+pop 0x03
+pop 0x02
+pop 0x01
+pop 0x00
+pop psw
+ret
+; Hit: C=1, DPS.0=1, DPTR1 at the high bank/flags byte.
+; Miss: C=0. R0/R1 and DPTR1 scratch only; DPTR0/B never change.
+; SoA table layout and 128-line geometry are fixed by cache_config.h.
+lookup:
+mov a,dpl
+swap a
+anl a,#0x0f
+mov r0,a
+mov a,dph
+anl a,#0x07
+swap a
+orl a,r0
+rl a
+mov r0,a
+mov dpl1,a
+mov dph1,#(DOOM_CACHE_OFFSETS_BASE >> 8)
+orl dps,#1
+movx a,@dptr
+mov r1,a
+mov a,dpl
+anl a,#0xf0
+xrl a,r1
+jnz lookup_miss
+inc dptr
+movx a,@dptr
+xrl a,dph
+jnz lookup_miss
+mov dpl1,r0
+mov dph1,#(DOOM_CACHE_BANKS_BASE >> 8)
+movx a,@dptr
+xrl a,b
+jnz lookup_miss
+inc dptr
+movx a,@dptr
+anl a,#0x7f
+cjne a,#(DOOM_CACHE_VALID >> 8),lookup_miss
+setb c
+ret
+lookup_miss:
+clr c
+ret
+.area DSEG (DATA)
+save_ret_lo: .ds 1
+save_ret_hi: .ds 1
diff --git a/fw/doom/doors.c b/fw/doom/doors.c
new file mode 100644
index 0000000..7154129
--- /dev/null
+++ b/fw/doom/doors.c
@@ -0,0 +1,168 @@
+/* Small native manual-door state machine for the standalone controller.
+ * Manual raise/wait/close and raise/stay, with per-line colour locks.
+ * Conservative player/actor obstruction reopens a closing door. */
+#include "doors.h"
+__xdata __at(DOOR_STATE_BASE) door_state_t door_states[DOOR_LIMIT];
+volatile __xdata __at(DOOR_INFO_BASE) door_info_t door_info;
+volatile __xdata __at(KEY_INFO_BASE) uint16_t key_info[4];
+volatile __xdata __at(SWITCH_INFO_BASE) uint16_t switch_info[4];
+__xdata __at(SWITCH_TIMER_BASE) uint8_t switch_timers[SWITCH_LIMIT];
+volatile __xdata __at(EXIT_INFO_BASE) uint16_t exit_info[4];
+static uint32_t switch_base,action_base;
+static uint8_t switch_count;
+static __xdata switch_def_t button_definition;
+static uint32_t defs_base;
+static const uint16_t *links;
+static __xdata door_def_t definition;
+static uint8_t last_use;
+static uint8_t (*things_block)(const door_def_t *,int16_t);
+void DoorSetThingsBlock(uint8_t (*check)(const door_def_t *,int16_t)) {things_block=check;}
+int32_t finesineapprox(int16_t angle);
+int32_t finecosineapprox(int16_t angle);
+
+static uint8_t read_def(uint8_t id)
+{
+    static uint16_t source;
+    source=(uint16_t)DdrMapRead(defs_base+((uint16_t)id<<5));
+    if(!source)return 0;
+    DoomCopy16(((uint32_t)(uint16_t)&definition<<16)|source);
+    source=(uint16_t)DdrMapRead(defs_base+((uint16_t)id<<5)+16);
+    if(!source)return 0;
+    DoomCopy16(((uint32_t)((uint16_t)&definition+16)<<16)|source);
+    return 1;
+}
+static uint8_t read_switch(uint8_t id)
+{
+    uint16_t source=(uint16_t)DdrMapRead(switch_base+16+((uint16_t)id<<4));
+    if(!source){door_info.fault=3;return 0;}
+    DoomCopy16(((uint32_t)(uint16_t)&button_definition<<16)|source);
+    return 1;
+}
+static void switch_texture(uint8_t on)
+{
+    int16_t *p;
+    if(!button_definition.texture)return;
+    p=DdrPointer(button_definition.texture);*p=on ? button_definition.on:button_definition.off;
+}
+void DoorInit(uint32_t data)
+{
+    static const uint16_t *header;
+    static uint8_t i;
+    door_info.count=door_info.last_used=door_info.reopens=door_info.fault=0;
+    door_info.activations=door_info.updates=0;last_use=0;things_block=0;
+    for(i=0;i<4;++i)key_info[i]=0;
+    switch_base=action_base=0;switch_count=0;
+    for(i=0;i<4;++i)switch_info[i]=0;
+    for(i=0;i<4;++i)exit_info[i]=0;
+    exit_info[1]=65535;
+    for(i=0;i<SWITCH_LIMIT;++i)switch_timers[i]=0;
+    if(!data)return;
+    header=DdrPointer(data);
+    if(header[0]>DOOR_LIMIT){door_info.fault=1;return;}
+    door_info.count=header[0];
+    action_base=*(const uint32_t *)(header+6);
+    switch_base=*(const uint32_t *)(header+4);
+    if(switch_base) {
+        header=DdrPointer(switch_base);
+        if(header[0]>SWITCH_LIMIT){door_info.fault=3;return;}
+        switch_count=header[0];
+        header=DdrPointer(data);
+    }
+    if(!door_info.count)return;
+    links=DdrPointer(*(const uint32_t *)(header+2));defs_base=data+16;
+    for(i=0;i<door_info.count;++i){
+        if(!read_def(i)){door_info.fault=2;return;}
+        door_states[i].height=DoorSectorCeiling(definition.sector);
+        door_states[i].phase=door_states[i].height<=definition.closed ? DOOR_CLOSED:DOOR_OPEN_STAY;
+        door_states[i].wait=door_states[i].stay=door_states[i].reserved=0;
+    }
+}
+
+static uint8_t occupied(int16_t next)
+{
+    static int16_t x,y;
+    if(things_block && things_block(&definition,next))return 1;
+    if(next>=motion_state.floor+MOTION_PLAYER_HEIGHT)return 0;
+    x=motion_state.x>>16;y=motion_state.y>>16;
+    return x+MOTION_PLAYER_RADIUS>=definition.minx && x-MOTION_PLAYER_RADIUS<=definition.maxx &&
+           y+MOTION_PLAYER_RADIUS>=definition.miny && y-MOTION_PLAYER_RADIUS<=definition.maxy;
+}
+void DoorTick(void)
+{
+    static uint8_t i,use,token,colour,required,button;
+    static int16_t angle,end_x,end_y,next;
+    static uint16_t j,action;
+    static uint32_t targets;
+    if(key_info[3] && !--key_info[3])key_info[1]=0;
+    if(exit_info[0] || (!door_info.count && !switch_count) || door_info.fault)return;
+    for(button=0;button<switch_count;++button) {
+        if(switch_timers[button] && !--switch_timers[button]) {
+            if(!read_switch(button))return;
+            switch_texture(0);++switch_info[1];
+        }
+    }
+    use=motion_input.buttons&DOOR_USE_BUTTON;
+    if(use && !last_use){
+        angle=(uint16_t)(motion_state.angle>>19);
+        end_x=(motion_state.x+FixedMul((int32_t)DOOR_USE_RANGE*65536L,finecosineapprox(angle)))>>16;
+        end_y=(motion_state.y+FixedMul((int32_t)DOOR_USE_RANGE*65536L,finesineapprox(angle)))>>16;
+        token=MotionTraceUse(end_x,end_y);
+        action=token ? ((const uint16_t *)DdrPointer(action_base))[token]:0;
+        i=(action&DOOR_ACTION_ID_MASK)-1;
+        if(action&DOOR_ACTION_SWITCH) {
+            button=i;
+            if(button<switch_count && !(switch_info[2]&(1U<<button)) && !switch_timers[button]) {
+                if(!read_switch(button))return;
+                targets=button_definition.targets;
+                if(targets || button_definition.kind) {
+                    switch_texture(1);++switch_info[0];switch_info[3]=button+1;
+                    if(action&DOOR_ACTION_REPEAT)switch_timers[button]=SWITCH_RESET_TICKS;
+                    else switch_info[2]|=1U<<button;
+                    if(button_definition.kind) {
+                        exit_info[0]=button_definition.kind;exit_info[1]=button_definition.line;++exit_info[2];
+                        return;
+                    }
+                    for(i=0;i<door_info.count;++i)if(targets&(1UL<<i)) {
+                        door_info.last_used=i+1;++door_info.activations;
+                        door_states[i].stay=(action&DOOR_ACTION_STAY)!=0;
+                        door_states[i].phase=DOOR_OPENING;door_states[i].wait=0;
+                    }
+                }
+            }
+        } else if(token && i<door_info.count){
+            colour=(action>>DOOR_ACTION_KEY_SHIFT)&3;
+            required=colour==1 ? KEY_BLUE_MASK:(colour==2 ? KEY_YELLOW_MASK:KEY_RED_MASK);
+            if(colour && !(key_info[0]&required)) {
+                key_info[1]=1U<<(colour-1);++key_info[2];key_info[3]=KEY_NOTICE_TICKS;
+            } else {
+                key_info[1]=key_info[3]=0;
+                door_info.last_used=i+1;++door_info.activations;
+                door_states[i].stay=(action&DOOR_ACTION_STAY)!=0;
+                if(door_states[i].phase!=DOOR_OPENING){door_states[i].phase=DOOR_OPENING;door_states[i].wait=0;}
+            }
+        }
+    }
+    last_use=use;
+    for(i=0;i<door_info.count;++i){
+        if(door_states[i].phase==DOOR_CLOSED || door_states[i].phase==DOOR_OPEN_STAY)continue;
+        if(!read_def(i)){door_info.fault=2;return;}
+        next=door_states[i].height;
+        if(door_states[i].phase==DOOR_WAITING){
+            if(door_states[i].wait && !--door_states[i].wait)door_states[i].phase=DOOR_CLOSING;
+            continue;
+        }
+        if(door_states[i].phase==DOOR_OPENING){
+            next+=DOOR_SPEED;
+            if(next>=definition.top){next=definition.top;door_states[i].phase=door_states[i].stay ? DOOR_OPEN_STAY:DOOR_WAITING;door_states[i].wait=DOOR_WAIT_TICKS;}

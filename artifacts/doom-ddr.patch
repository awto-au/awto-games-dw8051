+        else if(op==3){result=MotionVisible(query[0],query[1],query[2],query[3],query[4]);op=0;}
+        else if(op==4){MotionSetThingsBlock(body);op=0;}
+        else if(op==5){DoorSetThingsBlock(door_body);op=0;}
+    }

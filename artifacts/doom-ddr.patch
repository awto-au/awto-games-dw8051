+        value=finesineTable_part_1[i];
+        if(x&4096)return -value;
+        return value;
+    }""")
+    t=function_replace(t,"finecosineapprox", """fixed_t finecosineapprox(int16_t x) {
+        return finesineapprox((x+2048)&8191);
+    }""")

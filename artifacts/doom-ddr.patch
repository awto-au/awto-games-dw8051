+            address=block['address'];length=block['bytes']
+            if address%4096 or length!=4096 or address<=previous or address+length>len(memory):raise ValueError('invalid translated memory block')
+            raw=archive.read(f'{address:08x}.bin')
+            if len(raw)!=length or hashlib.sha256(raw).hexdigest()!=block['sha256']:raise ValueError('translated block checksum mismatch')
+            blocks.append((address,raw));previous=address
+        boot=bytes.fromhex(info['boot'])
+        if len(boot)!=78:raise ValueError('translated boot size mismatch')
+        # Validation completes before mutating the caller's memory.
+        for address,raw in blocks:memory[address:address+len(raw)]=raw
+    return boot,assets
diff --git a/scripts/doom_banks.py b/scripts/doom_banks.py
new file mode 100644
index 0000000..e13ba76
--- /dev/null
+++ b/scripts/doom_banks.py
@@ -0,0 +1,106 @@
+"""Link native projectile/pickup routines against audited bank-zero exports."""
+import json,re,hashlib
+from pathlib import Path
+
+def symbols(path):
+    return {n:(int(a,16),space or '') for space,a,n in re.findall(r'^\s*(?:([CD]):)?\s*([0-9A-Fa-f]{8})\s+([_\w.$]+)\b',path.read_text(),re.M)}
+
+def build(R,sdcc,linker,flags,out):
+    base=R.ROOT/'fw/doom';src=(base/'projectiles.c').read_text()
+    for n in ('Init','Spawn','Tick'):src=src.replace('Projectile'+n,'BankProjectile'+n)
+    for n in ('Init','Tick'):src=src.replace('Pickup'+n,'BankPickup'+n)
+    src=re.sub(r'__code __at\(0xFF94\).*?;','',src)
+    (out/'projectile_engine.c').write_text(src)
+    R.assemble_c(sdcc,[*flags,'-I'+str(base)],out/'projectile_engine.c',out/'projectile_engine.rel')
+    rel=(out/'projectile_engine.rel').read_text().replace(' sdcccall(0)','');(out/'projectile_engine.rel').write_text(rel)
+    # No bank-local DATA/bit variables may alias the common stack/register area.
+    for area in ('DSEG','BSEG','ISEG','OSEG'):
+        m=re.search(r'^A '+area+r' size ([0-9A-Fa-f]+)',rel,re.M)
+        if m and int(m[1],16):raise ValueError('bank-local '+area+' requires explicit allocation')
+    main=symbols(out/'doom_renderer.map')
+    xbase=max(main.get('s_'+area,(0,''))[0]+main.get('l_'+area,(0,''))[0] for area in ('XSEG','XISEG','PSEG'))
+    entry=''' .module projectile_entry
+.globl _BankProjectileInit,_BankProjectileSpawn,_BankProjectileTick
+.globl _BankPickupInit,_BankPickupTick
+.area ENTRY (ABS,CODE)
+.org 0x5000
+ljmp _BankProjectileInit
+ljmp _BankProjectileSpawn
+ljmp _BankProjectileTick
+ljmp _BankPickupInit
+ljmp _BankPickupTick
+'''
+    (out/'projectile_entry.asm').write_text(entry)
+    R.run([sdcc.parent/'sdas8051','-losg',out/'projectile_entry.rel',out/'projectile_entry.asm'])
+    lines=['-muwx','-i '+str(out/'projectile_engine.ihx'),'-b CSEG=0x5010','-b CONST=0x7000','-b XSEG=0x%X'%xbase]
+    imports={}
+    for n in re.findall(r'^S (\S+) Ref',rel,re.M):
+        if n=='.__.ABS.':continue
+        if n not in main:raise ValueError('bank-zero export missing: '+n)
+        address,space=main[n]
+        if space=='C' and 0x5000<=address<0x7100:raise ValueError('overlay masks its own dependency: '+n)
+        imports[n]=address;lines.append('-g '+n+'=0x%X'%address)
+    lines.extend([str(out/'projectile_entry.rel'),str(out/'projectile_engine.rel'),''])
+    (out/'projectile_engine.lk').write_text('\n'.join(lines))
+    R.run([linker.parent/'sdld','-nf',out/'projectile_engine.lk'])
+    engine=symbols(out/'projectile_engine.map')
+    for area in ('GSINIT','XINIT','XISEG'):
+        if engine.get('l_'+area,(0,''))[0]:raise ValueError('unsupported bank-local initializer area '+area)
+    end=engine['s_CSEG'][0]+engine['l_CSEG'][0]
+    if end>0x7000 or engine.get('l_CONST',(0,''))[0]:raise ValueError('projectile overlay exceeded audited range')
+    xend=engine['s_XSEG'][0]+engine['l_XSEG'][0]
+    if xend>0xE000:raise ValueError('projectile engine exceeds dynamic MCU XRAM')
+    import doom_sim as S
+    b0=S.load_ihx(out/'doom_renderer.ihx');overlay=S.load_ihx(out/'projectile_engine.ihx')
+    b1=bytearray(b0);b1[0x5000:end]=overlay[0x5000:end]
+    assert b0[:0x5000]==b1[:0x5000]
+    b2,graphics=graphics_bank(R,sdcc,linker,flags,out,b0,xend)
+    combined=b0+b1+b2
+    (out/'doom_renderer.bin').write_bytes(combined)
+    info=dict(bank0_sha256=hashlib.sha256(b0).hexdigest(),image_sha256=hashlib.sha256(combined).hexdigest(),banks=3,graphics=graphics,overlay_start=0x5000,overlay_end=end,common_end=0x5000,imports=imports,
+              engine_xram_start=xbase,engine_xram_end=xend,engine_xram_bytes=xend-xbase,
+              note='Three native code banks; common bytes and callable dependencies are duplicated. Bank selection uses the existing simulator MOVX FFFF model, not verified monitor register wiring.')
+    (out/'banking.json').write_text(json.dumps(info,indent=2))
+
+
+def graphics_bank(R,sdcc,linker,flags,out,b0,xbase):
+    """A separate native graphics bank keeps renderer expansion out of bank zero."""
+    src=(R.ROOT/'fw/doom/hud.c').read_text().replace('R_DrawCombatHUD','BankDrawCombatHUD')+'\n'+(R.ROOT/'fw/doom/planes.c').read_text()
+    (out/'graphics_engine.c').write_text(src)
+    R.assemble_c(sdcc,[*flags,'-I'+str(R.ROOT/'fw/doom')],out/'graphics_engine.c',out/'graphics_engine.rel')
+    rel=(out/'graphics_engine.rel').read_text().replace(' sdcccall(0)','');(out/'graphics_engine.rel').write_text(rel)
+    for area in ('DSEG','BSEG','ISEG','OSEG'):
+        m=re.search(r'^A '+area+r' size ([0-9A-Fa-f]+)',rel,re.M)
+        if m and int(m[1],16):raise ValueError('graphics bank-local '+area+' requires explicit allocation')
+    entry=''' .module graphics_entry
+.globl _BankDrawCombatHUD,_BankDrawPlane
+.area ENTRY (ABS,CODE)
+.org 0x5000
+ljmp _BankDrawCombatHUD
+ljmp _BankDrawPlane
+'''
+    (out/'graphics_entry.asm').write_text(entry)
+    R.run([sdcc.parent/'sdas8051','-losg',out/'graphics_entry.rel',out/'graphics_entry.asm'])
+    main=symbols(out/'doom_renderer.map');imports={}
+    lines=['-muwx','-i '+str(out/'graphics_engine.ihx'),'-b CSEG=0x5010','-b CONST=0x7000','-b XSEG=0x%X'%xbase]
+    for n in re.findall(r'^S (\S+) Ref',rel,re.M):
+        if n=='.__.ABS.':continue
+        if n not in main:raise ValueError('graphics export missing: '+n)
+        address,space=main[n]
+        if space=='C' and 0x5000<=address<0x7100:raise ValueError('graphics overlay masks dependency '+n)
+        imports[n]=address;lines.append('-g '+n+'=0x%X'%address)
+    lines.extend([str(out/'graphics_entry.rel'),str(out/'graphics_engine.rel'),''])
+    (out/'graphics_engine.lk').write_text('\n'.join(lines));R.run([linker.parent/'sdld','-nf',out/'graphics_engine.lk'])
+    engine=symbols(out/'graphics_engine.map')
+    for area in ('GSINIT','XINIT','XISEG'):
+        if engine.get('l_'+area,(0,''))[0]:raise ValueError('unsupported graphics initializer '+area)
+    end=engine['s_CSEG'][0]+engine['l_CSEG'][0]
+    const_end=engine.get('s_CONST',(0,''))[0]+engine.get('l_CONST',(0,''))[0]
+    if end>0x7000 or const_end>0x7100:raise ValueError('graphics code/constant overlay exceeded')
+    xend=engine['s_XSEG'][0]+engine['l_XSEG'][0]
+    if xend>0xE000:raise ValueError('graphics bank exceeds dynamic XRAM')
+    import doom_sim as S
+    overlay=S.load_ihx(out/'graphics_engine.ihx');bank=bytearray(b0)
+    end=max(end,const_end if engine.get('l_CONST',(0,''))[0] else 0)
+    bank[0x5000:end]=overlay[0x5000:end]
+    return bank,dict(overlay_start=0x5000,overlay_end=end,engine_xram_start=xbase,engine_xram_end=xend,engine_xram_bytes=xend-xbase,imports=imports)
diff --git a/scripts/doom_cache_gen.py b/scripts/doom_cache_gen.py
new file mode 100644
index 0000000..a0f7653
--- /dev/null
+++ b/scripts/doom_cache_gen.py
@@ -0,0 +1,980 @@
+#!/usr/bin/env python3
+"""DW8051 cache miss/eviction and MCU_DC burst transport, native SDCC ABI."""
+from pathlib import Path
+out=[]
+def emit(s): out.extend(s.strip().splitlines())
+
+emit('''; Generated by scripts/doom_cache_gen.py.
+; Native DW8051 bank-zero ABI; no interrupts or C calls.
+; Fifteen bytes of OSEG scratch, shared only with mutually exclusive routines.
+.module doom_cache_native
+.include "doom_cache_config.inc"
+.globl _DdrFetch, _DdrStore, _DdrRead, _DdrWrite, _DdrMapWrite, _DdrMapRead, _DdrWriteRaw
+.globl _DdrPresentRow, _DdrGatherTile, _DdrLoadColumn, _DdrLoadColorMap
+.globl _DdrClearFrame, _DdrPresentFrame, _DdrDrawColumn
+.globl _doom_draw_address, _doom_draw_count, _doom_draw_color, _doom_frame_active
+.globl _doom_column_frac, _doom_column_step
+.globl _DoomShadeRun, _DoomFillChunk
+.globl _DoomReciprocalStep, _DoomFixedDiv
+.globl _ddr_fault, _ddr_hits, _ddr_misses, _doom_burst_source
+.globl _doom_colormap_address, _doom_texture_address
+.globl _DoomWrite16, _DoomRead16, _DoomCopy16, _DoomTranspose16, _DoomExpand16
+acc = 0xe0
+b = 0xf0
+.area OSEG (OVR,DATA)
+copy_target: .ds 2
+copy_blocks: .ds 1
+.ds 12
+; These 15 bytes overlay the mutually exclusive clear/column-copy scratch.
+; Gather, expand and burst-write callees do not use OSEG.
+present_source = copy_target
+present_tile = copy_target + 4
+present_row = copy_target + 8
+present_x = copy_target + 12
+present_y = copy_target + 13
+present_n = copy_target + 14
+draw_source = copy_target
+draw_remaining = copy_target + 4
+draw_color = copy_target + 5
+draw_mode = copy_target + 6
+draw_chunk = copy_target + 7
+draw_target = copy_target + 8
+.area CSEG (CODE)
+''')
+
+def load_address(label):
+    for reg in range(4):emit(f'mov r{reg+4},({label}+{reg})')
+    emit('lcall prepare_address')
+
+def add_state(label,value):
+    for byte in range(4):
+        emit(f'mov a,({label}+{byte})\n'+('add' if byte==0 else 'addc')+f' a,#0x{(value>>(byte*8))&255:02x}\nmov ({label}+{byte}),a')
+
+emit('''_DoomReciprocalStep:
+; Exact low 16 bits of (0xffffffff / d) >> 7, for positive d.
+; floor(floor(N/d)/128) = floor((2^25-1)/d).
+; FixedDiv(512,d) gives floor(2^25/d); subtract one iff d divides 2^25.
+mov r0,a
+mov r1,b
+mov r2,dph
+mov r3,dpl
+clr c
+subb a,#2
+jc reciprocal_small
+mov dptr,#0
+ret
+reciprocal_small:
+mov a,r0
+orl a,r1
+orl a,r2
+orl a,r3
+jnz reciprocal_nonzero
+mov dptr,#0
+ret
+reciprocal_nonzero:
+clr c
+mov a,r3
+subb a,#1
+anl a,r3
+mov r7,a
+mov a,r2
+subb a,#0
+anl a,r2
+orl a,r7
+mov r7,a
+mov a,r1
+subb a,#0
+anl a,r1
+orl a,r7
+mov r7,a
+mov a,r0
+subb a,#0
+anl a,r0
+orl a,r7
+jnz reciprocal_no_correction
+mov a,#1
+sjmp reciprocal_divide
+reciprocal_no_correction:
+clr a
+reciprocal_divide:
+push acc
+mov r4,#0
+mov r5,#0
+mov r6,#2
+mov r7,#0
+lcall _DoomFixedDiv
+pop acc
+jz reciprocal_result
+mov a,r7
+clr c
+subb a,#1
+mov r7,a
+mov a,r6
+subb a,#0
+mov r6,a
+reciprocal_result:
+mov dpl,r7
+mov dph,r6
+ret''')
+
+emit('''_DdrDrawColumn:
+mov draw_mode,dpl
+mov dptr,#_doom_draw_address''')
+for byte in range(4):emit(f'movx a,@dptr\nmov (draw_source+{byte}),a\ninc dptr')
+emit('''mov dptr,#_doom_draw_count
+movx a,@dptr
+jnz draw_nonempty
+ret
+draw_nonempty:
+mov draw_remaining,a
+mov dptr,#_doom_draw_color
+movx a,@dptr
+mov draw_color,a
+draw_next:
+mov a,draw_source
+anl a,#15
+cpl a
+add a,#17
+mov draw_chunk,a
+clr c
+subb a,draw_remaining
+jc draw_chunk_ready
+mov draw_chunk,draw_remaining
+draw_chunk_ready:''')
+load_address('draw_source')
+emit('''lcall _DdrMapWrite
+mov a,dpl
+orl a,dph
+jnz draw_valid
+ret
+draw_valid:
+mov a,draw_mode
+jnz draw_shaded
+mov b,draw_color
+mov a,draw_chunk
+lcall _DoomFillChunk
+sjmp draw_advance
+draw_shaded:
+mov draw_target,dpl
+mov (draw_target+1),dph
+mov dptr,#_doom_column_step
+movx a,@dptr
+mov r4,a
+inc dptr
+movx a,@dptr
+mov r5,a
+mov dptr,#_doom_column_frac
+movx a,@dptr
+mov r6,a
+inc dptr
+movx a,@dptr
+mov r7,a
+mov r2,draw_chunk
+mov dpl,draw_target
+mov dph,(draw_target+1)
+lcall _DoomShadeRun
+mov r0,dpl
+mov r1,dph
+mov dptr,#_doom_column_frac
+mov a,r0
+movx @dptr,a
+inc dptr
+mov a,r1
+movx @dptr,a
+draw_advance:
+mov a,draw_source
+add a,draw_chunk
+mov draw_source,a
+mov a,(draw_source+1)
+addc a,#0
+mov (draw_source+1),a
+mov a,(draw_source+2)
+addc a,#0
+mov (draw_source+2),a
+mov a,(draw_source+3)
+addc a,#0
+mov (draw_source+3),a
+mov a,draw_remaining
+clr c
+subb a,draw_chunk
+mov draw_remaining,a
+jz draw_done
+ljmp draw_next
+draw_done:
+ret''')
+
+emit('_DdrPresentFrame:')
+for label,value in [('present_source','DOOM_INDEXED_BASE'),('present_tile','DOOM_RASTER_BASE')]:
+    for byte in range(4):emit(f'mov ({label}+{byte}),#{value}_BYTE{byte}')
+emit('''mov present_y,#(DOOM_VIEW_HEIGHT / 16)
+present_tile_y:
+mov present_x,#((DOOM_VIEW_WIDTH + 15) / 16)
+present_tile_x:''')
+load_address('present_source')
+emit('lcall _DdrGatherTile')
+for byte in range(4):emit(f'mov (present_row+{byte}),(present_tile+{byte})')
+emit('''mov present_n,#0
+present_scanline:
+mov a,present_n
+swap a
+mov dpl,a
+mov dph,#(DOOM_TILE_BASE >> 8)
+lcall _DoomExpand16''')
+load_address('present_row')
+emit('lcall _DdrPresentRow')
+# DdrPresentRow returns the last burst address (row start + 32).
+for byte in range(4):
+    emit(f'mov a,r{byte+4}\n'+('add' if byte==0 else 'addc')+f' a,#(((DOOM_RASTER_PITCH - 32) >> {8*byte}) & 0xff)\nmov (present_row+{byte}),a')
+emit('''inc present_n
+mov a,present_n
+cjne a,#16,present_scanline''')
+add_state('present_source',16*128)
+add_state('present_tile',48)
+emit('djnz present_x,present_more_x\nsjmp present_end_x\npresent_more_x:\nljmp present_tile_x\npresent_end_x:')
+# Constant expressions need the selected viewport at assembly time.
+for label,expr in [('present_source','16 - ((DOOM_VIEW_WIDTH + 15) / 16) * 16 * DOOM_TEXTURE_COLUMN_SIZE'),('present_tile','15 * DOOM_RASTER_PITCH')]:
+    for byte in range(4):
+        emit(f'mov a,({label}+{byte})\n'+('add' if byte==0 else 'addc')+f' a,#((({expr}) >> {8*byte}) & 0xff)\nmov ({label}+{byte}),a')
+emit('djnz present_y,present_more_y\nret\npresent_more_y:\nljmp present_tile_y')
+
+emit('''_DdrClearFrame:
+; Clear the first-touch bitmap, then discard old indexed cache lines.
+mov dptr,#DOOM_FRAME_BITMAP_BASE
+mov r0,#0
+clr a
+frame_clear_bitmap:
+movx @dptr,a
+inc dptr
+djnz r0,frame_clear_bitmap
+mov dptr,#DOOM_CACHE_BANKS_BASE
+mov r0,#DOOM_CACHE_LINES
+frame_invalidate:
+movx a,@dptr
+inc dptr
+cjne a,#DOOM_INDEXED_BASE_BYTE2,frame_keep
+movx a,@dptr
+anl a,#1
+cjne a,#DOOM_INDEXED_BASE_BYTE3,frame_keep
+clr a
+movx @dptr,a
+frame_keep:
+inc dptr
+djnz r0,frame_invalidate
+mov dptr,#_doom_frame_active
+mov a,#1
+movx @dptr,a
+ret
+
+; R4..R7 address, R0 preserved. Carry set only on the first touch of an
+; indexed line in this frame. R1..R3/B/DPTR are scratch. Other DDR is untouched.
+frame_touch:
+mov a,r7
+cjne a,#DOOM_INDEXED_BASE_BYTE3,frame_outside
+mov a,r6
+cjne a,#DOOM_INDEXED_BASE_BYTE2,frame_outside
+mov dptr,#_doom_frame_active
+movx a,@dptr
+jz frame_outside
+mov a,r4
+anl a,#0xf0
+clr c
+subb a,#DOOM_INDEXED_BASE_BYTE0
+mov r2,a
+mov a,r5
+subb a,#DOOM_INDEXED_BASE_BYTE1
+mov r3,a
+jc frame_outside
+mov a,r2
+clr c
+subb a,#(DOOM_FRAME_INDEXED_BYTES & 0xff)
+mov a,r3
+subb a,#(DOOM_FRAME_INDEXED_BYTES >> 8)
+jnc frame_outside
+mov a,r2
+swap a
+anl a,#7
+mov r1,a
+mov a,#1
+cjne r1,#0,frame_shift
+sjmp frame_mask_ready
+frame_shift:
+rl a
+djnz r1,frame_shift
+frame_mask_ready:
+mov b,a
+mov a,r2
+rl a
+anl a,#1
+mov r1,a
+mov a,r3
+rl a
+orl a,r1
+mov dpl,a
+mov dph,#(DOOM_FRAME_BITMAP_BASE >> 8)
+movx a,@dptr
+mov r1,a
+anl a,b
+jnz frame_outside
+mov a,r1
+orl a,b
+movx @dptr,a
+setb c
+ret
+frame_outside:
+clr c
+ret
+
+_DdrPresentRow:
+mov r4,dpl
+mov r5,dph
+mov r6,b
+mov r7,a
+mov dptr,#_doom_burst_source
+mov a,#(DOOM_CACHE_BURST_BASE & 0xff)
+movx @dptr,a
+inc dptr
+mov a,#(DOOM_CACHE_BURST_BASE >> 8)
+movx @dptr,a
+lcall prepare_address
+lcall _DdrWriteRaw
+lcall add16
+mov dptr,#_doom_burst_source
+mov a,#((DOOM_CACHE_BURST_BASE + 16) & 0xff)
+movx @dptr,a
+lcall prepare_address
+lcall _DdrWriteRaw
+lcall add16
+mov dptr,#_doom_burst_source
+mov a,#((DOOM_CACHE_BURST_BASE + 32) & 0xff)
+movx @dptr,a
+lcall prepare_address
+ljmp _DdrWriteRaw
+
+_DdrGatherTile:
+mov r4,dpl
+mov r5,dph
+mov r6,b
+mov r7,a
+gather_column:
+lcall prepare_address
+lcall _DdrFetch
+mov a,dpl
+cjne a,#0xff,gather_valid
+ret
+gather_valid:
+mov r0,a
+lcall data_pointer
+; Recover the column within this 16-column tile from the physical address.
+mov a,r4
+clr c
+subb a,#(DOOM_INDEXED_BASE & 0xff)
+mov r2,a
+mov a,r5
+subb a,#((DOOM_INDEXED_BASE >> 8) & 0xff)
+anl a,#7
+rl a
+mov r3,a
+mov a,r2
+rl a
+anl a,#1
+orl a,r3
+mov b,a
+mov a,#(DOOM_TILE_BASE >> 8)
+lcall _DoomTranspose16
+mov a,b
+cjne a,#15,gather_next
+ret
+gather_next:
+mov a,r4
+add a,#DOOM_TEXTURE_COLUMN_SIZE
+mov r4,a
+mov a,r5
+addc a,#0
+mov r5,a
+mov a,r6
+addc a,#0
+mov r6,a
+mov a,r7
+addc a,#0
+mov r7,a
+sjmp gather_column
+
+_DdrLoadColumn:
+mov r4,dpl
+mov r5,dph
+mov r6,b
+mov r7,a
+mov dptr,#_doom_texture_address
+movx a,@dptr
+cjne a,0x04,texture_load
+inc dptr
+movx a,@dptr
+cjne a,0x05,texture_load
+inc dptr
+movx a,@dptr
+cjne a,0x06,texture_load
+inc dptr
+movx a,@dptr
+cjne a,0x07,texture_load
+ret
+texture_load:
+mov dptr,#_doom_texture_address
+mov a,r4
+movx @dptr,a
+inc dptr
+mov a,r5
+movx @dptr,a
+inc dptr
+mov a,r6
+movx @dptr,a
+inc dptr
+mov a,r7
+movx @dptr,a
+mov copy_target,#(DOOM_TEXTURE_COLUMN_BASE & 0xff)
+mov copy_target+1,#(DOOM_TEXTURE_COLUMN_BASE >> 8)
+mov copy_blocks,#(DOOM_TEXTURE_COLUMN_SIZE / DOOM_DDR_BURST_BYTES)
+lcall copy_aligned
+jc texture_return
+mov dptr,#_doom_texture_address
+clr a
+movx @dptr,a
+inc dptr
+movx @dptr,a
+inc dptr
+movx @dptr,a
+inc dptr
+movx @dptr,a
+texture_return:
+ret
+
+_DdrLoadColorMap:
+mov r4,dpl
+mov r5,dph
+mov r6,b
+mov r7,a
+mov dptr,#_doom_colormap_address
+movx a,@dptr
+cjne a,0x04,colormap_load
+inc dptr
+movx a,@dptr

+        assert len(m.ddr.memory) == (1024 * 1024 if custom else D.SIZE)
+        assert sum(isinstance(d, D.DdrMemory) for d in m.devs) == 1
+        m.ddr.memory[-1] = 42
+        snap = m.snapshot()
+        m.ddr.memory[-1] = 77
+        m.restore(snap)
+        assert m.ddr.memory[-1] == 42
+        assert m.ddr.core is m.core
+    finally:
+        m.core.free()

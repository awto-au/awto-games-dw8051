+clr c
+mov a,r3
+subb a,#1
+anl a,r3
+mov r7,a
+mov a,r2
+subb a,#0
+anl a,r2
+orl a,r7
+mov r7,a
+mov a,r1
+subb a,#0
+anl a,r1
+orl a,r7
+mov r7,a
+mov a,r0
+subb a,#0
+anl a,r0
+orl a,r7

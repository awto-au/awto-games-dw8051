@@ -0,0 +1,136 @@
+"""Native controller/collision fixtures; no host moves the player."""
+import json,struct,sys
+from pathlib import Path
+import pytest
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'scripts'))
+from test_doom_platform import build_platform
+import doom_sim as S,ddr_sim as D,fastmachine as F
+
+STATE=struct.Struct('<iiIhhIBBBB')
+KEYS=('x','y','angle','floor','ceiling','ticks','blocked','frame_ticks','fault','enabled')
+
+@pytest.fixture(scope='module')
+def motion_image(tmp_path_factory):
+    out=tmp_path_factory.mktemp('native-motion')
+    build_platform(out,True,ROOT/'tests/doom_motion_fw.c',(ROOT/'fw/doom/motion.c',ROOT/'fw/doom/doors.c'))
+    return S.load_ihx(out/'platform.ihx')
+
+class Player:
+    def __init__(self,image,lines,*,floor_b=0,ceiling_b=128,x=0,y=0,angle=0,door=False,stay=False):
+        self.c=F.Core(image);self.c.set_dw(json.loads(F.MODEL_JSON.read_text()));self.c.reset();self.c.set_xpage_sfr(0x92)
+        self.c.set_ddr(D.config(),latency_clk=64)
+        for i,line in enumerate(lines):
+            line=(*line[:6],line[6]|(2 if not(line[6]&1) and (floor_b!=0 or ceiling_b!=128) else 0))
+            self.c.ddr_mem()[0x80010+i*16:0x80020+i*16]=struct.pack('<6h4B',*line,0,1,((129 if stay else 1) if door and i==0 else 0))
+        # Every cell references the same bounded list, stressing duplicate IDs.
+        words=[(-256)&65535,(-256)&65535,8,8]+[68]*64+[0,*range(len(lines)),65535]
+        raw=struct.pack('<'+'H'*len(words),*words)
+        self.c.ddr_mem()[0x90010:0x90010+len(raw)]=raw
+        if door:
+            header=struct.pack('<HHI8x',1,1,0xA2010)
+            definition=struct.pack('<HhhHH4h14x',1,0,124,0,1,64,80,-128,128)
+            self.c.ddr_mem()[0xA0010:0xA0010+48]=header+definition
+            self.c.ddr_mem()[0xA2010:0xA2012]=struct.pack('<H',0)
+        self.c.xram[0xF640:0xF64A]=struct.pack('<Hhhhh',len(lines),0,floor_b,128,ceiling_b)
+        self.c.xram[0xF6A0:0xF6B8]=STATE.pack(x*65536,y*65536,angle,0,128,0,0,0,0,0)
+        for _ in range(20):
+            self.c.run(10000)
+            if self.c.xram[0xF600]==0xA5:break
+        else:pytest.fail('motion init did not return')
+    def frame(self,forward=0,strafe=0,turn=0,enabled=1,buttons=0):
+        self.c.xram[0xF610:0xF616]=struct.pack('<bbhBB',forward,strafe,turn,enabled,buttons)
+        self.c.xram[0xF620]=1
+        for _ in range(50):
+            self.c.run(10000)
+            if not self.c.xram[0xF620]:break
+        else:pytest.fail(f'motion stalled at {self.c.p.pc:x}')
+        assert self.c.p.sp_wrap==0
+        assert self.c.ddr_stats()['invalid']==self.c.ddr_stats()['hazards']==0
+        result=dict(zip(KEYS,STATE.unpack(self.c.xram[0xF6A0:0xF6B8])))
+        assert result['fault']==0
+        return result
+    def free(self): self.c.free()
+
+@pytest.mark.parametrize('floor_b,ceiling_b,solid,passable',[(0,128,1,False),(0,128,0,True),(24,128,0,True),(25,128,0,False),(0,55,0,False),(24,79,0,False),(24,80,0,True),(-64,128,0,True)])
+def test_wall_steps_and_headroom(motion_image,floor_b,ceiling_b,solid,passable):
+    p=Player(motion_image,[(64,-128,64,128,max(0,floor_b),min(128,ceiling_b),solid)],floor_b=floor_b,ceiling_b=ceiling_b)
+    try:
+        states=[p.frame(forward=8) for _ in range(12)]
+        last=states[-1]
+        if passable:
+            assert last['x']>64*65536
+            assert last['floor']==floor_b
+        else:
+            assert last['x']==48*65536
+            assert any(s['blocked']&1 for s in states)
+        assert last['ticks']==16
+    finally:p.free()
+
+def test_tick_clock_controls_and_wall_slide(motion_image):
+    p=Player(motion_image,[(64,-128,64,256,0,0,1)])
+    try:
+        states=[p.frame(forward=127,strafe=4) for _ in range(10)]
+        assert [s['frame_ticks'] for s in states]==[1,1,2,1,2]*2
+        assert states[-1]['x']==48*65536
+        assert states[-1]['y']==56*65536
+        assert states[-1]['ticks']==14
+        before=states[-1]
+        off=p.frame(forward=8,enabled=0)
+        assert off['x']==before['x'] and off['ticks']==before['ticks'] and off['frame_ticks']==0
+    finally:p.free()
+
+@pytest.mark.parametrize('angle,forward,strafe,xy',[(0,-4,0,(-4,0)),(0,0,-4,(0,-4)),(1<<30,4,0,(0,4)),(3<<30,4,0,(0,-4))])
+def test_signed_and_rotated_commands(motion_image,angle,forward,strafe,xy):
+    p=Player(motion_image,[(500,-128,500,128,0,0,1)],angle=angle)
+    try:
+        r=p.frame(forward=forward,strafe=strafe)
+        assert (r['x'],r['y'])==(xy[0]*65536,xy[1]*65536)
+    finally:p.free()
+
+@pytest.mark.parametrize('turn,expected',[(32767,0x10000000),(-32768,0xF0000000)])
+def test_native_turn_clamp(motion_image,turn,expected):
+    p=Player(motion_image,[(500,-128,500,128,0,0,1)])
+    try:assert p.frame(turn=turn)['angle']==expected
+    finally:p.free()
+
+def test_diagonal_wall_and_maximum_command_do_not_tunnel(motion_image):
+    import doom_motion as M
+    lines=[(-128,128,128,-128,0,0,1)]
+    p=Player(motion_image,lines,x=-64,y=-64)
+    try:
+        results=[p.frame(forward=127,strafe=127) for _ in range(16)]
+        for state in results:
+            assert state['x']+state['y']<=-32*65536
+            M.validate_pose(state,lines)
+        assert any(s['blocked'] for s in results)
+    finally:p.free()
+
+
+def test_exact_geometric_oracle_touch_and_crossing():
+    import doom_motion as M
+    assert M.crosses_open_box(-10,0,10,0,-1,1,-1,1)
+    assert M.crosses_open_box(10,0,-10,0,-1,1,-1,1)
+    assert not M.crosses_open_box(-10,1,10,1,-1,1,-1,1)
+    assert not M.crosses_open_box(1,1,2,2,-1,1,-1,1)
+
+
+def test_native_wad_movement_and_independent_pose_render(tmp_path):
+    import os
+    import doom_renderer as R
+    from test_doom_platform import toolchain
+    wad=os.environ.get('AWTO_DOOM_WAD')
+    if not wad:pytest.skip('set AWTO_DOOM_WAD')
+    sdcc,linker,lib=toolchain(True)
+    R.build(sdcc,linker,lib,tmp_path,width=30,height=48)
+    commands=[dict(forward=8) for _ in range(20)]+[dict(forward=3,strafe=2,turn=256) for _ in range(20)]
+    result,_=R.simulate(Path(wad),tmp_path,yaw=0,commands=commands,frames=len(commands),latency=64)
+    assert all(f['motion_verified'] for f in result['frames'])
+    assert any(f['motion']['blocked'] for f in result['frames'])
+    assert result['frames'][-1]['motion']['ticks']==56
+    from PIL import Image
+    for i in (0,19,39):
+        state=result['frames'][i]['motion']
+        pose=dict(x=state['x'],y=state['y'],angle=state['angle'],viewz=(state['floor']+41)*65536)
+        R.simulate(Path(wad),tmp_path,initial_pose=pose,latency=64)
+        assert Image.open(tmp_path/f'frame-{i:03d}.png').tobytes()==Image.open(tmp_path/'e1m1-native.png').tobytes()
diff --git a/tests/test_doom_platform.py b/tests/test_doom_platform.py
new file mode 100644
index 0000000..3b4e2a0
--- /dev/null
+++ b/tests/test_doom_platform.py
@@ -0,0 +1,125 @@
+"""Real SDCC C ABI and native DDR pointer/cache tests; optional IWAD render.
+
+Set AWTO_DOOM_SDCC, AWTO_DOOM_LINKER, AWTO_DOOM_LIB_LARGE,
+AWTO_DOOM_LIB_STACK to the compiler/driver/runtime directories. No WAD needed
+for the platform tests. AWTO_DOOM_WAD enables renderer integration too.
+"""
+import json
+import os
+import random
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+
+def toolchain(stack):
+    names = ["AWTO_DOOM_SDCC", "AWTO_DOOM_LINKER", "AWTO_DOOM_LIB_STACK" if stack else "AWTO_DOOM_LIB_LARGE"]
+    values = [os.environ.get(n) for n in names]
+    if not all(values): pytest.skip("set " + ", ".join(names))
+    return [Path(v) for v in values]
+
+
+def build_platform(out, stack, fixture=None, extra_sources=()):
+    import doom_renderer as R
+    sdcc, linker, libdir = toolchain(stack)
+    R.cache_config(out)
+    flags = ["-mmcs51", "--model-large", "--std-sdcc11", "--opt-code-speed"]
+    asm = ["fixed_math", "ddr_pointer", "fixed_stack_abi" if stack else "fixed_abi", "gptr_cmp", "video", "cache_native"]
+    for name in asm:
+        R.assemble_runtime(sdcc,out,name)
+    fixture=fixture or ROOT/"tests/doom_platform_fw.c"
+    for src in [fixture,ROOT/"fw/doom/ddr_cache.c",*extra_sources]:
+        extra = ["--stack-auto", "-DDOOM_STACK"] if stack and src.stem != "ddr_cache" else ["--sloc-xdata"]
+        R.assemble_c(sdcc,[*flags,*extra],src,out/(src.stem+".rel"))
+        rel=out/(src.stem+".rel")
+        rel.write_text(rel.read_text().replace(" sdcccall(0)",""))
+    objects=[out/(n+".rel") for n in [fixture.stem,"ddr_cache",*(src.stem for src in extra_sources),*asm]]
+    R.run([linker,*flags,*( ["--stack-auto"] if stack else []),"--xram-loc","0xD700","--xram-size","0x900",
+           "--iram-size","256","--lib-path",libdir,*objects,"-o",out/"platform.ihx"])
+
+
+@pytest.mark.parametrize("stack",[False,True])
+@pytest.mark.parametrize("drop_every",[0,7])
+def test_native_c_platform(tmp_path,stack,drop_every):
+    import fastmachine as F
+    import ddr_sim as D
+    import doom_sim as S
+    build_platform(tmp_path,stack)
+    core=F.Core(S.load_ihx(tmp_path/"platform.ihx"))
+    core.set_dw(json.loads(F.MODEL_JSON.read_text()))
+    core.reset()
+    core.set_xpage_sfr(0x92)
+    core.set_ddr(D.config(),latency_clk=64)
+    core.L.core_ddr_drop_every(core.h,0,drop_every)
+    try:
+        for _ in range(1000):
+            core.run(100000)
+            assert core.p.sp_wrap==0
+            if core.xram[0xF600]==0xA5: break
+        else: pytest.fail(f"C platform timed out at {core.p.pc:04X}")
+        assert core.xram[0xF601]==0
+        assert core.ddr_mem()[0x1FFFFFF]==0x51
+        assert core.ddr_mem()[0x3FFFFF]==0xD0
+        assert core.ddr_stats()["invalid"]==core.ddr_stats()["hazards"]==0
+        ram=core.ddr_mem()
+        assert bytes(ram[0x16000E:0x160033]) == bytes([0]+[7]*35+[0])
+        shaded=[((((0xF123+i*0x1ABC)&0xFFFF)>>9)^0x55)^0xAA for i in range(35)]
+        assert bytes(ram[0x16100E:0x161033]) == bytes([0]+shaded+[0])
+        if drop_every: assert core.ddr_stats()["dropped"]>0
+        # Exercise ordinary compiled C calls, not direct entry to private maths.
+        edge=[-0x80000000,-65537,-65536,-1,0,1,255,256,65535,65536,65537,0x7FFFFFFF]
+        pairs=[(a,b) for a in edge for b in edge]
+        rng=random.Random(8051)
+        pairs += [(S.signed(rng.getrandbits(32)),S.signed(rng.getrandbits(32))) for _ in range(1000)]
+        for a,b in pairs:
+            core.xram[0xF620:0xF628]=(a&0xFFFFFFFF).to_bytes(4,"little")+(b&0xFFFFFFFF).to_bytes(4,"little")
+            for op in (1,2):
+                core.xram[0xF62C]=op
+                core.run(2000)
+                assert core.xram[0xF62C]==0
+                got=S.signed(int.from_bytes(core.xram[0xF628:0xF62C],"little"))
+                assert got==S.reference(a,b,op==2),(a,b,op,got)
+        assert core.p.sp_wrap==0
+        # Exact unsigned reciprocal over the full uint32 domain, including
+        # quotient truncation and every power-of-two correction boundary.
+        denominators={1,0x1FFFFFF,0x2000000,0xFFFFFFFF}
+        for bit in range(32):
+            for delta in (-1,0,1):
+                value=(1<<bit)+delta
+                if 0<value<=0xFFFFFFFF: denominators.add(value)
+        denominators.update(rng.randrange(1,0x100000000) for _ in range(2000))
+        denominators.update(rng.randrange(1,0x2000000) for _ in range(2000))
+        for d in denominators:
+            core.xram[0xF620:0xF624]=d.to_bytes(4,"little")
+            core.xram[0xF62C]=3
+            core.run(2000)
+            assert core.xram[0xF62C]==0
+            got=int.from_bytes(core.xram[0xF628:0xF62C],"little")
+            assert got==((0xFFFFFFFF//d)>>7)&0xFFFF,(d,got)
+    finally: core.free()
+
+
+@pytest.mark.parametrize("width,height,frames,latency,drop_every",[(60,128,1,64,7),(40,80,8,64,0),(40,64,8,64,0)])
+def test_e1m1_renderer(tmp_path,width,height,frames,latency,drop_every):
+    import doom_renderer as R
+    sdcc,linker,libdir=toolchain(True)
+    wad=os.environ.get("AWTO_DOOM_WAD")
+    if not wad: pytest.skip("set AWTO_DOOM_WAD to an original Doom 1 shareware IWAD")
+    R.build(sdcc,linker,libdir,tmp_path,width=width,height=height)
+    result,_=R.simulate(Path(wad),tmp_path,latency=latency,drop_every=drop_every,frames=frames,yaw=0,yaw_step=45)
+    assert result["palette_verified"]
+    assert result["stack_wraps"]==0
+    if drop_every: assert result["ddr"]["dropped"]>0
+    if frames > 1:
+        # Timing is reported; functional integration has no minimum FPS.
+        # Rotating the native renderer must reproduce an independently booted
+        # frame: catches stale pixels/cache state across frames.
+        from PIL import Image
+        for i in (1,4,7):
+            R.simulate(Path(wad),tmp_path,yaw=i*45,latency=latency)
+            with Image.open(tmp_path/f"frame-{i:03d}.png") as seq, Image.open(tmp_path/"e1m1-native.png") as single:
+                assert seq.tobytes()==single.tobytes()

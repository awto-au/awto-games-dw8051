+def add_state(label,value):
+    for byte in range(4):
+        emit(f'mov a,({label}+{byte})\n'+('add' if byte==0 else 'addc')+f' a,#0x{(value>>(byte*8))&255:02x}\nmov ({label}+{byte}),a')

+b = 0xf0
+.area OSEG (OVR,DATA)
+copy_target: .ds 2
+copy_blocks: .ds 1
+.ds 12
+; These 15 bytes overlay the mutually exclusive clear/column-copy scratch.
+; Gather, expand and burst-write callees do not use OSEG.
+present_source = copy_target
+present_tile = copy_target + 4
+present_row = copy_target + 8
+present_x = copy_target + 12
+present_y = copy_target + 13
+present_n = copy_target + 14
+draw_source = copy_target
+draw_remaining = copy_target + 4
+draw_color = copy_target + 5
+draw_mode = copy_target + 6
+draw_chunk = copy_target + 7
+draw_target = copy_target + 8
+.area CSEG (CODE)
+''')
+
+def load_address(label):
+    for reg in range(4):emit(f'mov r{reg+4},({label}+{reg})')
+    emit('lcall prepare_address')

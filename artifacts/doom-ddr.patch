+#define DOOM_DDR_CMD_READ         0xA0
+#define DOOM_DDR_READY            1
+#define DOOM_DDR_POLL_LIMIT       1024
+#define DOOM_DDR_READ_ATTEMPTS    3
+#define DOOM_PALETTE_BYTES        768
+#define DOOM_RASTER_BASE          0x01F00000
